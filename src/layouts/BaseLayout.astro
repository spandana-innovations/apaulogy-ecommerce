---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchOverlay from '../components/SearchOverlay.astro';
import CartDrawer from '../components/CartDrawer.astro';
import { SITE_NAME, SITE_DESCRIPTION } from '../lib/seo';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article' | 'product';
  noindex?: boolean;
  /** JSON-LD objects to embed */
  jsonld?: Record<string, unknown>[];
}

const {
  title,
  description = SITE_DESCRIPTION,
  image = '/og-default.svg',
  type = 'website',
  noindex = false,
  jsonld = [],
} = Astro.props;

const fullTitle = title ? `${title} — ${SITE_NAME}` : `${SITE_NAME} — Watercolours of a city that was`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).toString();
const ogImage = new URL(image, Astro.site ?? Astro.url.origin).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <!-- Open Graph -->
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en_IN" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#000000" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Preload the display font for a snappy first paint of titles.
         Uncomment once /public/fonts/brandywine.woff2 is added (see README > Fonts),
         so we don't ship a 404 preload before the file exists.
    <link rel="preload" href="/fonts/brandywine.woff2" as="font" type="font/woff2" crossorigin />
    -->
    <link rel="preconnect" href="https://checkout.razorpay.com" />

    {jsonld.map((obj) => (
      <script type="application/ld+json" set:html={JSON.stringify(obj)} />
    ))}
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:bg-black focus:text-white focus:px-4 focus:py-2">
      Skip to content
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <SearchOverlay />
    <CartDrawer />

    <script src="../scripts/cart.ts"></script>
    <script>
      // #20 — deter casual image copying (right-click, drag, long-press save).
      // Note: no client protection is absolute, but this removes the easy paths.
      function guardImages() {
        document.querySelectorAll('img.protected, .art-guard img, .frame img').forEach((img) => {
          const el = img as HTMLElement;
          if (el.dataset.guarded) return;
          el.dataset.guarded = '1';
          el.setAttribute('draggable', 'false');
          el.addEventListener('dragstart', (e) => e.preventDefault());
          el.addEventListener('contextmenu', (e) => e.preventDefault());
        });
      }
      // Block right-click specifically over artwork containers
      document.addEventListener('contextmenu', (e) => {
        const t = e.target as HTMLElement;
        if (t.closest('.art-guard, .frame, #zoom-lightbox')) e.preventDefault();
      });
      guardImages();
      document.addEventListener('astro:after-swap', guardImages);
      document.addEventListener('astro:page-load', guardImages);
    </script>
  </body>
</html>
