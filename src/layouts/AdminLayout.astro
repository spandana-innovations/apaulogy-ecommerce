---
export interface Props { title: string; active: string; dbBound?: boolean; }
const { title, active, dbBound = true } = Astro.props;
import '@fontsource-variable/inter';
const nav = [
  { key: 'dashboard',   label: 'Dashboard',      href: '/apaulogy-admin/',            icon: 'grid' },
  { key: 'orders',      label: 'Orders',         href: '/apaulogy-admin/orders/',     icon: 'bag' },
  { key: 'stats',       label: 'Stats',          href: '/apaulogy-admin/stats/',      icon: 'chart' },
  { key: 'analytics',   label: 'Site analytics', href: '/apaulogy-admin/analytics/',  icon: 'pulse' },
  { key: 'products',    label: 'Products',       href: '/apaulogy-admin/products/',   icon: 'tag' },
  { key: 'categories',  label: 'Categories',     href: '/apaulogy-admin/categories/', icon: 'grid' },
  { key: 'discounts',   label: 'Discounts',      href: '/apaulogy-admin/discounts/',  icon: 'tag' },
  { key: 'shipping',    label: 'Shipping',       href: '/apaulogy-admin/shipping/',   icon: 'truck' },
  { key: 'customers',   label: 'Customers',      href: '/apaulogy-admin/customers/',  icon: 'users' },
  { key: 'requests',    label: 'Data requests',  href: '/apaulogy-admin/requests/',   icon: 'shield' },
  { key: 'messages',    label: 'Messages',       href: '/apaulogy-admin/messages/',   icon: 'chat' },
  { key: 'settings',    label: 'Settings',       href: '/apaulogy-admin/settings/',   icon: 'cog' },
];
const ICONS: Record<string,string> = {
  grid:'<path d="M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM14 14h6v6h-6z"/>',
  bag:'<path d="M6 8h12l1 12H5zM9 8V6a3 3 0 0 1 6 0v2" stroke-linejoin="round"/>',
  tag:'<path d="M3 12l9-9 9 9-9 9z" stroke-linejoin="round"/><circle cx="9" cy="9" r="1.4"/>',
  users:'<circle cx="9" cy="8" r="3.2"/><path d="M3 20c0-3.3 2.7-5.5 6-5.5s6 2.2 6 5.5M16 5a3 3 0 0 1 0 6M21 20c0-2.6-1.6-4.5-4-5.2"/>',
  mail:'<rect x="3" y="5" width="18" height="14" rx="1"/><path d="m3 7 9 6 9-6"/>',
  shield:'<path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6z" stroke-linejoin="round"/>',
  chat:'<path d="M4 5h16v11H8l-4 4z" stroke-linejoin="round"/>',
  chart:'<path d="M4 20V10M10 20V4M16 20v-8M22 20H2"/>',
  pulse:'<path d="M3 12h4l2-6 4 12 2-6h6"/>',
  truck:'<path d="M3 6h11v9H3zM14 9h4l3 3v3h-7z"/><circle cx="7" cy="18" r="1.6"/><circle cx="17" cy="18" r="1.6"/>',
  cog:'<circle cx="12" cy="12" r="3.2"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M5 5l2 2M17 17l2 2M5 19l2-2M17 7l2-2"/>',
};
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex,nofollow" />
  <title>{title} · aPaulogy Admin</title>
  <style is:global>
    :root{
      --bg:#060f1a; --panel:#0e1b2b; --panel-2:#0a1523; --raise:#122238;
      --ink:#e9eef4; --ink-soft:#b7c3d1; --muted:#7b8a9c; --line:rgba(255,255,255,.08); --line-strong:rgba(255,255,255,.16);
      --gold:#c9a24a; --gold-soft:rgba(201,162,74,.16); --blue:#3ea6ff;
      --ok:#39d98a; --ok-bg:rgba(57,217,138,.14); --warn:#ffcf5c; --warn-bg:rgba(255,207,92,.14);
      --info:#6cb6ff; --info-bg:rgba(108,182,255,.14); --bad:#ff7a7a; --bad-bg:rgba(255,122,122,.14);
      --r:12px; --r-sm:8px; --shadow:0 1px 2px rgba(0,0,0,.4), 0 10px 30px rgba(0,0,0,.35);
      --font-display:"Inter Variable","Inter",-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
      --font-serif:"Inter Variable","Inter",-apple-system,sans-serif;
      --font-sans:"Inter Variable","Inter",-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;
    }
    *{ box-sizing:border-box; } html,body{ margin:0; }
    body{ font-family:var(--font-sans); color:var(--ink); background:var(--bg); -webkit-font-smoothing:antialiased; }
    a{ color:inherit; text-decoration:none; }
    ::selection{ background:var(--gold-soft); }

    .app{ display:grid; grid-template-columns:250px 1fr; min-height:100vh; }
    /* #1 — light theme */
    html[data-theme="light"]{
      --bg:#f5f6f8; --panel:#ffffff; --panel-2:#f7f8fa; --raise:#eef1f4;
      --ink:#141a22; --ink-soft:#3d4653; --muted:#7a8494; --line:#e6e9ee; --line-strong:#d3d8e0;
      --gold:#a9842f; --gold-soft:rgba(169,132,47,.14); --blue:#2b7fff;
      --ok:#178a52; --ok-bg:#e3f6ec; --warn:#9a6a00; --warn-bg:#fbf1d6; --info:#1f6fd0; --info-bg:#e5effb; --bad:#c23b3b; --bad-bg:#fbe6e6;
      --shadow:0 1px 2px rgba(20,26,34,.05), 0 8px 26px rgba(20,26,34,.06);
    }
    html[data-theme="light"] .app > aside{ background:#0e1620; }  /* keep sidebar dark for contrast */
    html[data-theme="light"] .brand b{ color:#fff; }
    html[data-theme="light"] nav a{ color:rgba(255,255,255,.7); }


    /* Sidebar */
    .app > aside{ background:#04090f; color:var(--ink); padding:1.3rem .9rem; position:sticky; top:0; height:100vh; overflow-y:auto; display:flex; flex-direction:column; gap:.2rem; border-right:1px solid var(--line); }
    .brand{ display:flex; align-items:center; gap:.7rem; padding:.2rem .6rem 1rem; }
    .brand img{ width:34px; height:34px; background:#fff; border-radius:9px; padding:3px; }
    .brand b{ font-family:var(--font-display); font-weight:700; font-size:1.15rem; letter-spacing:-.01em; color:var(--ink); }
    .brand-flourish{ display:none; }
    nav{ display:flex; flex-direction:column; gap:2px; margin-top:.2rem; }
    nav a{ display:flex; align-items:center; gap:.75rem; padding:.62rem .8rem; border-radius:var(--r-sm);
      font-size:.82rem; font-weight:500; color:var(--ink-soft); transition:all .13s; }
    nav a:hover{ background:rgba(255,255,255,.05); color:#fff; }
    nav a.on{ background:linear-gradient(90deg,var(--gold-soft),transparent); color:#fff; box-shadow:inset 2px 0 0 var(--gold); }
    nav a.on svg{ color:var(--gold); opacity:1; }
    nav svg{ width:18px; height:18px; flex:none; opacity:.65; }

    .side-util{ margin-top:auto; padding-top:.8rem; border-top:1px solid var(--line); display:flex; flex-direction:column; gap:2px; }
    .side-btn{ display:flex; align-items:center; gap:.75rem; padding:.62rem .8rem; border-radius:var(--r-sm); background:none; border:0; cursor:pointer;
      font-family:var(--font-sans); font-size:.82rem; font-weight:500; color:var(--ink-soft); transition:all .13s; text-align:left; }
    .side-btn:hover{ background:rgba(255,255,255,.05); color:#fff; }
    .side-btn svg{ opacity:.7; }
    html[data-theme="light"] .side-btn:hover{ background:rgba(255,255,255,.08); }
    /* Main */
    main{ padding:1.9rem 2.6rem 1.2rem; max-width:1360px; width:100%; display:flex; flex-direction:column; min-height:100vh; }
    main > .top ~ *:last-of-type{ } .adm-footer{ margin-top:auto !important; }
    .top{ display:flex; align-items:center; justify-content:space-between; margin-bottom:1.8rem; }
    .top h1{ font-family:var(--font-display); font-weight:700; font-size:1.9rem; letter-spacing:-.02em; margin:0; line-height:1.1; color:var(--ink); }

    /* Buttons */
    .btn{ display:inline-flex; align-items:center; gap:.45rem; border:1px solid var(--line-strong); background:var(--raise); color:var(--ink);
      padding:.55rem .95rem; font-size:.82rem; font-weight:500; cursor:pointer; border-radius:var(--r-sm); transition:all .13s; }
    .btn:hover{ border-color:var(--gold); color:#fff; }
    .btn:active{ transform:translateY(1px); }
    .btn[style*="background:#000"],.btn[style*="background:#111"]{ background:var(--gold) !important; color:#0a0f16 !important; border-color:var(--gold) !important; font-weight:600; }
    .btn[style*="color:#fff"]{ color:#0a0f16; }

    /* Cards */
    .card{ background:var(--panel); border:1px solid var(--line); border-radius:var(--r); box-shadow:var(--shadow); overflow:hidden; }

    /* Banner */
    .banner{ background:var(--gold-soft); border:1px solid rgba(201,162,74,.35); color:#e7cf95; padding:.9rem 1.15rem; border-radius:var(--r); font-size:.84rem; line-height:1.55; margin-bottom:1.6rem; }
    .banner code{ color:#fff; }

    /* Tables */
    table{ width:100%; border-collapse:collapse; font-size:.85rem; background:transparent; color:var(--ink); }
    th,td{ text-align:left; padding:.9rem 1.1rem; border-bottom:1px solid var(--line); }
    th{ font-size:.68rem; text-transform:uppercase; letter-spacing:.06em; color:var(--muted); background:var(--panel-2); font-weight:600; }
    tbody tr{ transition:background .1s; } tbody tr:hover{ background:var(--raise); }
    tr:last-child td{ border-bottom:0; }
    .u{ color:var(--ink); } .u:hover{ color:var(--gold); }
    strong{ color:#fff; }

    /* Status pills */
    .pill{ display:inline-flex; align-items:center; gap:.35rem; padding:.22rem .6rem; border-radius:20px; font-size:.7rem; font-weight:600; text-transform:capitalize; }
    .pill::before{ content:""; width:6px; height:6px; border-radius:50%; background:currentColor; }
    .s-pending,.s-on-hold{ background:var(--warn-bg); color:var(--warn); }
    .s-paid,.s-completed{ background:var(--ok-bg); color:var(--ok); }
    .s-shipped,.s-processing{ background:var(--info-bg); color:var(--info); }
    .s-fulfilled,.s-refunded{ background:rgba(255,255,255,.08); color:var(--ink-soft); }
    .s-cancelled,.s-failed{ background:var(--bad-bg); color:var(--bad); }

    .empty{ text-align:center; color:var(--muted); padding:3.5rem 1rem; font-family:var(--font-serif); font-size:1.1rem; }

    /* Stat cards */
    .grid-stats{ display:grid; grid-template-columns:repeat(auto-fit,minmax(190px,1fr)); gap:1.1rem; }
    .stat{ background:linear-gradient(180deg,var(--panel),var(--panel-2)); border:1px solid var(--line); border-radius:var(--r); padding:1.3rem 1.35rem; box-shadow:var(--shadow); transition:transform .13s, border-color .13s; }
    .stat:hover{ transform:translateY(-2px); border-color:var(--gold); }
    .stat .k{ font-size:.7rem; text-transform:uppercase; letter-spacing:.07em; color:var(--muted); font-weight:600; }
    .stat .v{ font-family:var(--font-display); font-weight:700; font-size:1.9rem; letter-spacing:-.02em; margin-top:.35rem; line-height:1; color:var(--ink); }

    /* Forms */
    input,select,textarea{ font:inherit; font-size:.88rem; padding:.6rem .75rem; border:1px solid var(--line-strong); border-radius:var(--r-sm); background:var(--panel-2); color:var(--ink); transition:border-color .13s, box-shadow .13s; }
    input::placeholder,textarea::placeholder{ color:var(--muted); }
    input:focus,select:focus,textarea:focus{ outline:none; border-color:var(--gold); box-shadow:0 0 0 3px var(--gold-soft); }
    select option{ background:var(--panel); color:var(--ink); }
    .muted{ color:var(--muted); }
    code{ font-family:ui-monospace,Menlo,monospace; background:var(--panel-2); padding:.1rem .35rem; border-radius:4px; }

    /* #4 — kill stray light backgrounds in dark mode (except real image thumbs) */
    html[data-theme="dark"] main [style*="background:#fff"]:not(img):not(.imgcell img){ background:var(--panel-2) !important; color:var(--ink); }
    html[data-theme="dark"] main [style*="background:#000"]:not(.rm-img){ }
    .imgcell img{ background:#fff !important; }  /* thumbnails need white behind transparent art */
    /* admin footer */
    .adm-footer{ margin-top:3rem; padding-top:1.4rem; border-top:1px solid var(--line); display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:1rem; font-size:.78rem; color:var(--muted); }
    .adm-footer .sep{ opacity:.4; margin:0 .3rem; }
    .adm-credit{ display:inline-flex; align-items:center; gap:.5rem; color:var(--muted); opacity:.8; transition:opacity .15s; }
    .adm-credit:hover{ opacity:1; }
    .adm-credit img{ width:22px; height:22px; }
    .adm-credit-name{ color:var(--ink-soft); font-weight:600; letter-spacing:.01em; }
    @media (max-width:860px){ .app{ grid-template-columns:1fr; } .app > aside{ position:static; height:auto; flex-direction:row; flex-wrap:wrap; align-items:center; } .app > aside nav{ flex-direction:row; flex-wrap:wrap; } main{ padding:1.2rem; } }
  </style>
</head>
<body>
  <div class="app">
    <aside>
      <div class="brand"><img src="/favicon.svg" alt="" /><b>aPaulogy</b></div>
      <svg class="brand-flourish" viewBox="0 0 200 8" preserveAspectRatio="none"><path d="M4 4 Q50 0 100 4 T196 3" fill="none" stroke="var(--gold)" stroke-width="1.4" stroke-linecap="round" opacity="0.7"/></svg>
      <nav>
        {nav.map((n) => (
          <a href={n.href} class={active === n.key ? 'on' : ''}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" set:html={ICONS[n.icon]} />
            {n.label}
          </a>
        ))}
      </nav>
      <div class="side-util">
        <button class="side-btn" id="theme-toggle" type="button" aria-label="Toggle theme">
          <svg id="theme-ico" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></svg>
          <span id="theme-label">Dark mode</span>
        </button>
        <button class="side-btn" id="logout" type="button" aria-label="Sign out">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/></svg>
          <span>Sign out</span>
        </button>
      </div>
    </aside>
    <main>
      <div class="top">
        <h1>{title}</h1>
      </div>
      {!dbBound && (
        <div class="banner"><strong>Live data isn't connected to this deployment yet.</strong> On your Cloudflare project → Settings → Bindings, confirm <code>DB</code> → <code>apaulogyecomm</code>, then <em>redeploy</em> (bindings only attach to new deployments). If the database is bound but empty, run the <code>db/import-*.sql</code> files in the D1 Console.</div>
      )}
      <slot />

      <footer class="adm-footer">
        <p>© {new Date().getFullYear()} aPaulogy Gallery <span class="sep">|</span> All artwork © Paul Fernandes</p>
        <a href="https://quantump2x.com" rel="noopener" target="_blank" class="adm-credit" aria-label="Quantum P2X">
          <img src="/brand/quantump2x.svg" alt="Quantum P2X" width="26" height="26" />
        </a>
      </footer>
    </main>
  </div>
  <script>
    const sun='<circle cx="12" cy="12" r="4.5"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M5 5l1.5 1.5M17.5 17.5 19 19M19 5l-1.5 1.5M6.5 17.5 5 19"/>';
    const moon='<path d="M20 14.5A8 8 0 1 1 9.5 4 6.5 6.5 0 0 0 20 14.5z"/>';
    function applyTheme(t){ document.documentElement.setAttribute('data-theme', t); const ico=document.getElementById('theme-ico'); if(ico) ico.innerHTML = t==='light' ? moon : sun; const lbl=document.getElementById('theme-label'); if(lbl) lbl.textContent = t==='light' ? 'Light mode' : 'Dark mode'; localStorage.setItem('apg_admin_theme', t); }
    applyTheme(localStorage.getItem('apg_admin_theme') || 'dark');
    document.getElementById('theme-toggle')?.addEventListener('click', ()=>{ applyTheme(document.documentElement.getAttribute('data-theme')==='light' ? 'dark' : 'light'); });

    document.getElementById('logout')?.addEventListener('click', async () => {
      await fetch('/api/admin/logout', { method: 'POST' });
      location.href = '/';
    });
  </script>
</body>
</html>
