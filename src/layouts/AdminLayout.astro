---
export interface Props { title: string; active: string; dbBound?: boolean; }
const { title, active, dbBound = true } = Astro.props;
import '@fontsource/cormorant-garamond/600.css';
import '@fontsource/eb-garamond/400.css';
import '@fontsource/eb-garamond/500.css';
const nav = [
  { key: 'dashboard',   label: 'Dashboard',      href: '/apaulogy-admin/',            icon: 'grid' },
  { key: 'orders',      label: 'Orders',         href: '/apaulogy-admin/orders/',     icon: 'bag' },
  { key: 'stats',       label: 'Stats',          href: '/apaulogy-admin/stats/',      icon: 'chart' },
  { key: 'products',    label: 'Products',       href: '/apaulogy-admin/products/',   icon: 'tag' },
  { key: 'categories',  label: 'Categories',     href: '/apaulogy-admin/categories/', icon: 'grid' },
  { key: 'discounts',   label: 'Discounts',      href: '/apaulogy-admin/discounts/',  icon: 'tag' },
  { key: 'shipping',    label: 'Shipping',       href: '/apaulogy-admin/shipping/',   icon: 'truck' },
  { key: 'customers',   label: 'Customers',      href: '/apaulogy-admin/customers/',  icon: 'users' },
  { key: 'requests',    label: 'Data requests',  href: '/apaulogy-admin/requests/',   icon: 'shield' },
  { key: 'messages',    label: 'Messages',       href: '/apaulogy-admin/messages/',   icon: 'chat' },
  { key: 'settings',    label: 'Settings',       href: '/apaulogy-admin/settings/',   icon: 'cog' },
];
const ICONS: Record<string,string> = {
  grid:'<path d="M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM14 14h6v6h-6z"/>',
  bag:'<path d="M6 8h12l1 12H5zM9 8V6a3 3 0 0 1 6 0v2" stroke-linejoin="round"/>',
  tag:'<path d="M3 12l9-9 9 9-9 9z" stroke-linejoin="round"/><circle cx="9" cy="9" r="1.4"/>',
  users:'<circle cx="9" cy="8" r="3.2"/><path d="M3 20c0-3.3 2.7-5.5 6-5.5s6 2.2 6 5.5M16 5a3 3 0 0 1 0 6M21 20c0-2.6-1.6-4.5-4-5.2"/>',
  mail:'<rect x="3" y="5" width="18" height="14" rx="1"/><path d="m3 7 9 6 9-6"/>',
  shield:'<path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6z" stroke-linejoin="round"/>',
  chat:'<path d="M4 5h16v11H8l-4 4z" stroke-linejoin="round"/>',
  chart:'<path d="M4 20V10M10 20V4M16 20v-8M22 20H2"/>',
  truck:'<path d="M3 6h11v9H3zM14 9h4l3 3v3h-7z"/><circle cx="7" cy="18" r="1.6"/><circle cx="17" cy="18" r="1.6"/>',
  cog:'<circle cx="12" cy="12" r="3.2"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M5 5l2 2M17 17l2 2M5 19l2-2M17 7l2-2"/>',
};
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex,nofollow" />
  <title>{title} · aPaulogy Admin</title>
  <style is:global>
    :root{ --ink:#000; --ink-soft:#2b2b2b; --muted:#767676; --line:#e6e2d9; --line-strong:#111; --paper:#f7f5f0; --paper-deep:#efece4; --gold:#b8973f;
      --font-display:"BrandyWine","Cormorant Garamond","Playfair Display",Georgia,serif;
      --font-serif:"EB Garamond",Georgia,serif;
      --font-sans:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif; }
    *{ box-sizing:border-box; } html,body{ margin:0; }
    body{ font-family:var(--font-serif); color:var(--ink); background:var(--paper); }
    a{ color:inherit; text-decoration:none; }
    .app{ display:grid; grid-template-columns:236px 1fr; min-height:100vh; }
    aside{ background:#000; color:#e9e6df; padding:1.1rem 0; position:sticky; top:0; height:100vh; overflow-y:auto; }
    .brand{ display:flex; align-items:center; gap:.6rem; padding:.2rem 1.2rem 1.1rem; border-bottom:1px solid rgba(255,255,255,.1); margin-bottom:.6rem; }
    .brand img{ width:26px; height:26px; background:#fff; border-radius:5px; padding:2px; }
    .brand b{ font-family:var(--font-display); font-weight:600; font-size:1.35rem; letter-spacing:.01em; }
    .brand-flourish{ display:block; width:78%; height:7px; margin:-.4rem 1.2rem .4rem; }
    aside{ display:flex; flex-direction:column; }
    .sidefig{ margin:auto 0 0; padding:1.2rem 1rem 1.4rem; text-align:center; opacity:.85; }
    .sidefig svg{ width:80px; height:62px; opacity:.75; }
    .sidefig figcaption{ font-family:var(--font-display); font-size:1.05rem; color:rgba(255,255,255,.45); margin-top:.3rem; }
    nav a{ display:flex; align-items:center; gap:.7rem; padding:.62rem 1.2rem; font-family:var(--font-sans); font-size:.74rem; text-transform:uppercase; letter-spacing:.11em; color:rgba(255,255,255,.65); border-left:3px solid transparent; }
    nav a:hover{ background:rgba(255,255,255,.05); color:#fff; }
    nav a.on{ color:#fff; border-left-color:var(--gold); background:rgba(255,255,255,.08); }
    nav svg{ width:17px; height:17px; flex:none; }
    main{ padding:1.7rem 2.4rem 3rem; max-width:none; width:100%; }
    .card{ transition:box-shadow .15s, transform .12s; }
    tbody tr{ transition:background .12s; } tbody tr:hover{ background:#faf9f6; }
    .top{ display:flex; align-items:center; justify-content:space-between; margin-bottom:1.4rem; }
    .top{ padding-bottom:1.1rem; border-bottom:1px solid var(--line); }
    .top h1{ font-family:var(--font-display); font-weight:600; font-size:2.4rem; margin:0; }
    .btn{ display:inline-flex; align-items:center; gap:.4rem; border:1px solid var(--ink); background:#fff; padding:.5rem .9rem; font-family:var(--font-sans); font-size:.72rem; text-transform:uppercase; letter-spacing:.08em; cursor:pointer; border-radius:0; }
    .btn:hover{ background:var(--ink); color:#fff; }
    .banner{ background:#fff7e6; border:1px solid #e8d9a8; color:#7a5c12; padding:.6rem .9rem; border-radius:3px; font-size:.82rem; margin-bottom:1.2rem; }
    .card{ background:#fff; border:1px solid var(--line); border-radius:6px; box-shadow:0 1px 2px rgba(20,18,15,.04); }
    table{ width:100%; border-collapse:collapse; font-family:var(--font-sans); font-size:.84rem; background:#fff; }
    th,td{ text-align:left; padding:.7rem .9rem; border-bottom:1px solid var(--line); }
    th{ font-size:.64rem; text-transform:uppercase; letter-spacing:.1em; color:var(--muted); background:#faf9f6; }
    tr:last-child td{ border-bottom:0; }
    .pill{ display:inline-block; padding:.15rem .55rem; border-radius:20px; font-size:.68rem; font-weight:600; text-transform:capitalize; }
    .s-pending{ background:#fff2d6; color:#8a6100; } .s-paid{ background:#dff0e0; color:#1f6b2e; }
    .s-shipped{ background:#dfe8f5; color:#26456f; } .s-fulfilled{ background:#e6e6e6; color:#333; } .s-cancelled{ background:#f6dede; color:#8a1f1f; }
    .s-processing{ background:#dfe8f5; color:#26456f; } .s-on-hold{ background:#fff2d6; color:#8a6100; }
    .s-completed{ background:#dff0e0; color:#1f6b2e; } .s-refunded{ background:#eee; color:#555; } .s-failed{ background:#f6dede; color:#8a1f1f; }
    .empty{ text-align:center; color:var(--muted); padding:3rem 1rem; }
    .grid-stats{ display:grid; grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); gap:1rem; }
    .stat{ background:#fff; border:1px solid var(--line); border-radius:6px; padding:1.15rem 1.25rem; box-shadow:0 1px 2px rgba(20,18,15,.04); position:relative; overflow:hidden; }
    .stat::before{ content:''; position:absolute; left:0; top:0; bottom:0; width:3px; background:var(--gold); opacity:.5; }
    .stat .k{ font-size:.68rem; text-transform:uppercase; letter-spacing:.09em; color:var(--muted); }
    .stat .v{ font-family:var(--font-display); font-size:2.1rem; margin-top:.15rem; line-height:1; }
    .muted{ color:var(--muted); }
    input,select{ font:inherit; padding:.5rem .7rem; border:1px solid var(--line); border-radius:3px; background:#fff; }
    @media (max-width:820px){ .app{ grid-template-columns:1fr; } aside{ position:static; height:auto; } }
  </style>
</head>
<body>
  <div class="app">
    <aside>
      <div class="brand"><img src="/favicon.svg" alt="" /><b>aPaulogy</b></div>
      <svg class="brand-flourish" viewBox="0 0 200 8" preserveAspectRatio="none"><path d="M4 4 Q50 0 100 4 T196 3" fill="none" stroke="var(--gold)" stroke-width="1.4" stroke-linecap="round" opacity="0.7"/></svg>
      <nav>
        {nav.map((n) => (
          <a href={n.href} class={active === n.key ? 'on' : ''}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" set:html={ICONS[n.icon]} />
            {n.label}
          </a>
        ))}
      </nav>
      <figure class="sidefig">
        <svg viewBox="0 0 90 70" fill="none" stroke="rgba(255,255,255,.45)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="20" cy="52" r="12"/><circle cx="68" cy="52" r="12"/>
          <path d="M20 52 L38 30 L68 52 M38 30 L44 16 M32 16 h16"/><circle cx="46" cy="9" r="6"/>
          <path d="M38 30 L54 30"/>
        </svg>
        <figcaption>Minding the shop</figcaption>
      </figure>
    </aside>
    <main>
      <div class="top">
        <h1>{title}</h1>
        <button class="btn" id="logout" aria-label="Sign out" title="Sign out" style="padding:.5rem;border-radius:0">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/></svg>
        </button>
      </div>
      {!dbBound && (
        <div class="banner"><strong>Live data isn't connected to this deployment yet.</strong> On your Cloudflare project → Settings → Bindings, confirm <code>DB</code> → <code>apaulogyecomm</code>, then <em>redeploy</em> (bindings only attach to new deployments). If the database is bound but empty, run the <code>db/import-*.sql</code> files in the D1 Console.</div>
      )}
      <slot />
    </main>
  </div>
  <script>
    document.getElementById('logout')?.addEventListener('click', async () => {
      await fetch('/api/admin/logout', { method: 'POST' });
      location.href = '/apaulogy-admin/login';
    });
  </script>
</body>
</html>
