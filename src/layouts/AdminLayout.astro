---
export interface Props { title: string; active: string; dbBound?: boolean; }
const { title, active, dbBound = true } = Astro.props;
import '@fontsource/cormorant-garamond/600.css';
import '@fontsource/eb-garamond/400.css';
import '@fontsource/eb-garamond/500.css';
const nav = [
  { key: 'dashboard',   label: 'Dashboard',      href: '/apaulogy-admin/',            icon: 'grid' },
  { key: 'orders',      label: 'Orders',         href: '/apaulogy-admin/orders/',     icon: 'bag' },
  { key: 'stats',       label: 'Stats',          href: '/apaulogy-admin/stats/',      icon: 'chart' },
  { key: 'products',    label: 'Products',       href: '/apaulogy-admin/products/',   icon: 'tag' },
  { key: 'categories',  label: 'Categories',     href: '/apaulogy-admin/categories/', icon: 'grid' },
  { key: 'discounts',   label: 'Discounts',      href: '/apaulogy-admin/discounts/',  icon: 'tag' },
  { key: 'shipping',    label: 'Shipping',       href: '/apaulogy-admin/shipping/',   icon: 'truck' },
  { key: 'customers',   label: 'Customers',      href: '/apaulogy-admin/customers/',  icon: 'users' },
  { key: 'requests',    label: 'Data requests',  href: '/apaulogy-admin/requests/',   icon: 'shield' },
  { key: 'messages',    label: 'Messages',       href: '/apaulogy-admin/messages/',   icon: 'chat' },
  { key: 'settings',    label: 'Settings',       href: '/apaulogy-admin/settings/',   icon: 'cog' },
];
const ICONS: Record<string,string> = {
  grid:'<path d="M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM14 14h6v6h-6z"/>',
  bag:'<path d="M6 8h12l1 12H5zM9 8V6a3 3 0 0 1 6 0v2" stroke-linejoin="round"/>',
  tag:'<path d="M3 12l9-9 9 9-9 9z" stroke-linejoin="round"/><circle cx="9" cy="9" r="1.4"/>',
  users:'<circle cx="9" cy="8" r="3.2"/><path d="M3 20c0-3.3 2.7-5.5 6-5.5s6 2.2 6 5.5M16 5a3 3 0 0 1 0 6M21 20c0-2.6-1.6-4.5-4-5.2"/>',
  mail:'<rect x="3" y="5" width="18" height="14" rx="1"/><path d="m3 7 9 6 9-6"/>',
  shield:'<path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6z" stroke-linejoin="round"/>',
  chat:'<path d="M4 5h16v11H8l-4 4z" stroke-linejoin="round"/>',
  chart:'<path d="M4 20V10M10 20V4M16 20v-8M22 20H2"/>',
  truck:'<path d="M3 6h11v9H3zM14 9h4l3 3v3h-7z"/><circle cx="7" cy="18" r="1.6"/><circle cx="17" cy="18" r="1.6"/>',
  cog:'<circle cx="12" cy="12" r="3.2"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M5 5l2 2M17 17l2 2M5 19l2-2M17 7l2-2"/>',
};
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex,nofollow" />
  <title>{title} · aPaulogy Admin</title>
  <style is:global>
    :root{
      --ink:#171512; --ink-soft:#413c34; --muted:#8b857a; --line:#ece8e0; --line-soft:#f2efe9;
      --paper:#f6f4ef; --panel:#ffffff; --panel-2:#fbfaf7;
      --gold:#b8973f; --gold-soft:#f4ecd8;
      --accent:#1a1815;
      --ok:#1f7a43; --ok-bg:#e6f4ea; --warn:#9a6a00; --warn-bg:#fdf3d8; --info:#2b5b9a; --info-bg:#e6eef8; --bad:#a02020; --bad-bg:#f9e4e4;
      --r:12px; --r-sm:8px; --shadow:0 1px 2px rgba(23,21,18,.04), 0 6px 20px rgba(23,21,18,.05);
      --font-display:"BrandyWine","Cormorant Garamond","Playfair Display",Georgia,serif;
      --font-serif:"EB Garamond",Georgia,serif;
      --font-sans:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;
    }
    *{ box-sizing:border-box; } html,body{ margin:0; }
    body{ font-family:var(--font-sans); color:var(--ink); background:var(--paper); -webkit-font-smoothing:antialiased; }
    a{ color:inherit; text-decoration:none; }
    ::selection{ background:var(--gold-soft); }

    .app{ display:grid; grid-template-columns:250px 1fr; min-height:100vh; }

    /* ---------- Sidebar ---------- */
    .app > aside{ background:#100f0d; color:#e9e6df; padding:1.3rem 0.9rem; position:sticky; top:0; height:100vh; overflow-y:auto; display:flex; flex-direction:column; gap:.2rem; }
    .brand{ display:flex; align-items:center; gap:.7rem; padding:.2rem .6rem 1rem; }
    .brand img{ width:34px; height:34px; background:#fff; border-radius:9px; padding:3px; }
    .brand b{ font-family:var(--font-display); font-weight:600; font-size:1.5rem; letter-spacing:.01em; }
    .brand-flourish{ display:none; }
    nav{ display:flex; flex-direction:column; gap:2px; margin-top:.2rem; }
    nav a{ display:flex; align-items:center; gap:.75rem; padding:.6rem .8rem; border-radius:var(--r-sm);
      font-size:.82rem; font-weight:500; letter-spacing:.005em; text-transform:none; color:rgba(255,255,255,.62); transition:all .13s; }
    nav a:hover{ background:rgba(255,255,255,.06); color:#fff; }
    nav a.on{ background:rgba(255,255,255,.1); color:#fff; }
    nav a.on svg{ color:var(--gold); opacity:1; }
    nav svg{ width:18px; height:18px; flex:none; opacity:.7; }
    .sidefig{ margin:auto .6rem .2rem; padding-top:1.2rem; border-top:1px solid rgba(255,255,255,.08); text-align:center; }
    .sidefig svg{ width:64px; height:50px; opacity:.5; }
    .sidefig figcaption{ font-family:var(--font-display); font-size:1rem; color:rgba(255,255,255,.4); margin-top:.35rem; }

    /* ---------- Main ---------- */
    main{ padding:1.9rem 2.6rem 4rem; max-width:1360px; width:100%; }
    .top{ display:flex; align-items:center; justify-content:space-between; margin-bottom:1.8rem; }
    .top h1{ font-family:var(--font-display); font-weight:600; font-size:2.6rem; margin:0; line-height:1; }

    /* ---------- Buttons ---------- */
    .btn{ display:inline-flex; align-items:center; gap:.45rem; border:1px solid var(--line); background:var(--panel);
      padding:.55rem .95rem; font-size:.82rem; font-weight:500; cursor:pointer; border-radius:var(--r-sm); transition:all .13s; box-shadow:0 1px 1px rgba(23,21,18,.03); }
    .btn:hover{ border-color:var(--ink); }
    .btn:active{ transform:translateY(1px); }
    .btn[style*="background:#000"],.btn[style*="background:#111"]{ border-color:var(--ink); }

    /* ---------- Cards ---------- */
    .card{ background:var(--panel); border:1px solid var(--line); border-radius:var(--r); box-shadow:var(--shadow); overflow:hidden; }

    /* ---------- Banner ---------- */
    .banner{ background:linear-gradient(90deg,var(--gold-soft),#fbf7ec); border:1px solid #ecdcb4; color:#7a5c12;
      padding:.9rem 1.15rem; border-radius:var(--r); font-size:.84rem; line-height:1.55; margin-bottom:1.6rem; box-shadow:var(--shadow); }

    /* ---------- Tables ---------- */
    table{ width:100%; border-collapse:collapse; font-size:.85rem; background:var(--panel); }
    th,td{ text-align:left; padding:.9rem 1.1rem; border-bottom:1px solid var(--line-soft); }
    th{ font-size:.68rem; text-transform:uppercase; letter-spacing:.06em; color:var(--muted); background:var(--panel-2); font-weight:600; }
    tbody tr{ transition:background .1s; } tbody tr:hover{ background:var(--panel-2); }
    tr:last-child td{ border-bottom:0; }
    .u{ color:var(--ink); text-decoration:none; } .u:hover{ color:var(--gold); }

    /* ---------- Status pills ---------- */
    .pill{ display:inline-flex; align-items:center; gap:.35rem; padding:.22rem .6rem; border-radius:20px; font-size:.7rem; font-weight:600; text-transform:capitalize; }
    .pill::before{ content:""; width:6px; height:6px; border-radius:50%; background:currentColor; opacity:.9; }
    .s-pending,.s-on-hold{ background:var(--warn-bg); color:var(--warn); }
    .s-paid,.s-completed{ background:var(--ok-bg); color:var(--ok); }
    .s-shipped,.s-processing{ background:var(--info-bg); color:var(--info); }
    .s-fulfilled,.s-refunded{ background:#eee9e0; color:#6b6459; }
    .s-cancelled,.s-failed{ background:var(--bad-bg); color:var(--bad); }

    .empty{ text-align:center; color:var(--muted); padding:3.5rem 1rem; font-family:var(--font-serif); font-size:1.1rem; }

    /* ---------- Stat cards ---------- */
    .grid-stats{ display:grid; grid-template-columns:repeat(auto-fit,minmax(190px,1fr)); gap:1.1rem; }
    .stat{ background:var(--panel); border:1px solid var(--line); border-radius:var(--r); padding:1.3rem 1.35rem; box-shadow:var(--shadow); transition:transform .13s, box-shadow .13s; }
    .stat:hover{ transform:translateY(-2px); box-shadow:0 8px 26px rgba(23,21,18,.09); }
    .stat .k{ font-size:.7rem; text-transform:uppercase; letter-spacing:.07em; color:var(--muted); font-weight:600; }
    .stat .v{ font-family:var(--font-display); font-size:2.5rem; margin-top:.3rem; line-height:1; color:var(--ink); }

    /* ---------- Forms ---------- */
    input,select,textarea{ font:inherit; font-size:.88rem; padding:.6rem .75rem; border:1px solid var(--line); border-radius:var(--r-sm); background:var(--panel); transition:border-color .13s, box-shadow .13s; }
    input:focus,select:focus,textarea:focus{ outline:none; border-color:var(--ink); box-shadow:0 0 0 3px rgba(184,151,63,.15); }
    .muted{ color:var(--muted); }
    code{ font-family:ui-monospace,Menlo,monospace; }

    @media (max-width:860px){ .app{ grid-template-columns:1fr; } .app > aside{ position:static; height:auto; flex-direction:row; flex-wrap:wrap; align-items:center; } .sidefig{ display:none; } .app > aside nav{ flex-direction:row; flex-wrap:wrap; } main{ padding:1.2rem; } }
  </style>
</head>
<body>
  <div class="app">
    <aside>
      <div class="brand"><img src="/favicon.svg" alt="" /><b>aPaulogy</b></div>
      <svg class="brand-flourish" viewBox="0 0 200 8" preserveAspectRatio="none"><path d="M4 4 Q50 0 100 4 T196 3" fill="none" stroke="var(--gold)" stroke-width="1.4" stroke-linecap="round" opacity="0.7"/></svg>
      <nav>
        {nav.map((n) => (
          <a href={n.href} class={active === n.key ? 'on' : ''}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" set:html={ICONS[n.icon]} />
            {n.label}
          </a>
        ))}
      </nav>
      <figure class="sidefig">
        <svg viewBox="0 0 90 70" fill="none" stroke="rgba(255,255,255,.45)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="20" cy="52" r="12"/><circle cx="68" cy="52" r="12"/>
          <path d="M20 52 L38 30 L68 52 M38 30 L44 16 M32 16 h16"/><circle cx="46" cy="9" r="6"/>
          <path d="M38 30 L54 30"/>
        </svg>
        <figcaption>Minding the shop</figcaption>
      </figure>
    </aside>
    <main>
      <div class="top">
        <h1>{title}</h1>
        <button class="btn" id="logout" aria-label="Sign out" title="Sign out" style="padding:.5rem;border-radius:0">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/></svg>
        </button>
      </div>
      {!dbBound && (
        <div class="banner"><strong>Live data isn't connected to this deployment yet.</strong> On your Cloudflare project → Settings → Bindings, confirm <code>DB</code> → <code>apaulogyecomm</code>, then <em>redeploy</em> (bindings only attach to new deployments). If the database is bound but empty, run the <code>db/import-*.sql</code> files in the D1 Console.</div>
      )}
      <slot />
    </main>
  </div>
  <script>
    document.getElementById('logout')?.addEventListener('click', async () => {
      await fetch('/api/admin/logout', { method: 'POST' });
      location.href = '/apaulogy-admin/login';
    });
  </script>
</body>
</html>
