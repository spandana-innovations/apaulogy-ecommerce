---
import BaseLayout from '../layouts/BaseLayout.astro';

const faqs = [
  { id: 'signed', q: 'Are the prints really signed by the artist?', a: 'Yes. Every fine-art print is personally signed by Paul Fernandes before it is packed and shipped.' },
  { id: 'quality', q: 'What is the print quality?', a: 'Prints are produced as archival giclée reproductions on heavyweight fine-art paper, colour-matched to the original watercolours.' },
  { id: 'framing', q: 'Do prints come framed?', a: 'Selected works are available both framed and unframed. Where a framed option exists you can choose it on the product page.' },
  { id: 'shipping', q: 'Where do you ship, and how long does it take?', a: 'We ship across India and worldwide. Within India, orders are typically dispatched in 3–5 working days and delivered in 5–9 working days. International timelines vary by destination.' },
  { id: 'charges', q: 'How much is shipping?', a: 'Shipping within India is a flat fee, and free for orders over ₹5,000. International shipping is calculated at checkout.' },
  { id: 'payments', q: 'What payment methods do you accept?', a: 'Payments are handled securely by Razorpay — UPI, credit and debit cards, net-banking and popular wallets are all supported.' },
  { id: 'returns', q: 'What is your returns policy?', a: 'If a piece arrives damaged, contact us within 7 days with photos and we will replace it. As artworks are made to order, we are unable to accept returns for change of mind.' },
  { id: 'custom', q: 'Can I commission or request a specific illustration?', a: 'For commissions, bulk gifting or corporate orders, please reach us via the contact page and we will be glad to help.' },
];

const jsonld = [{
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
}];
---

<BaseLayout title="FAQ" description="Answers about aPaulogy prints, shipping, payments and returns." jsonld={jsonld}>
  <div class="container-page py-16 max-w-3xl">
    <p class="eyebrow">Help</p>
    <h1 class="text-5xl mt-2 mb-8">Frequently asked questions</h1>
    <div class="divide-y divide-[var(--color-line)] border-y border-[var(--color-line)]">
      {faqs.map((f) => (
        <details id={f.id} class="group py-5">
          <summary class="flex items-center justify-between cursor-pointer list-none">
            <span class="text-xl pr-6">{f.q}</span>
            <span class="text-2xl text-[var(--color-terracotta)] transition-transform group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <p class="mt-3 text-[var(--color-ink-soft)]">{f.a}</p>
        </details>
      ))}
    </div>
    <p class="mt-10 text-[var(--color-ink-soft)]">Still have a question? <a href="/contact/" class="underline text-[var(--color-terracotta)]">Get in touch →</a></p>
  </div>
</BaseLayout>
