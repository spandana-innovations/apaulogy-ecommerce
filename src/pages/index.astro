---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductSlider from '../components/ProductSlider.astro';
import Icon from '../components/Icon.astro';
import { getProductsByCategory, getFeaturedProducts, getProduct } from '../lib/catalog';
import { categoryIcon } from '../lib/icons';
import { organizationSchema, websiteSchema, SITE_DESCRIPTION } from '../lib/seo';
import { SOCIALS } from '../lib/socials';

const heroBanner = '/uploads/2025/06/Untitled-design-17.webp';
const preorder = getProduct('pre-order-11-limited-colaba-to-bandra-life-in-mumbai');

const shelves = [
  { slug: 'bangalore-in-the-70s', title: "Bangalore in the 70's" },
  { slug: 'illustrations-on-tile', title: 'Illustrations on Tile' },
  { slug: 'mumbai-heritage', title: 'Mumbai Heritage' },
  { slug: 'vintage-mumbai', title: 'Vintage Mumbai' },
  { slug: 'mangalore-series', title: 'Mangalore Series' },
  { slug: 'a-goan-holiday', title: 'A Goan Holiday' },
  { slug: 'gods-own-kerala', title: "God's Own Kerala" },
].map((s) => ({ ...s, icon: categoryIcon(s.slug), products: getProductsByCategory(s.slug).slice(0, 12) }))
 .filter((s) => s.products.length);

const featured = getFeaturedProducts(10);

// #8 — the ways the art comes: choose your medium
const mediums = [{"icon": "frame", "name": "Mounted Prints", "desc": "Watercolour prints on paper, mounted and ready to frame.", "href": "/category/wall-art/", "ex": [{"slug": "pensioner", "name": "Pensioner", "img": "/uploads/2017/03/Pensioner-WITHWatermark1.webp"}, {"slug": "jackals-wedding", "name": "Jackals Wedding", "img": "/uploads/2017/03/apaulogyJackalsWedding-WITHWatermar.webp"}, {"slug": "plaza-theatre", "name": "Plaza Theatre", "img": "/uploads/2017/03/apaulogyPlaza-WITHWatermark.webp"}]}, {"icon": "tile", "name": "On Tile", "desc": "Favourite scenes transferred onto tile — lean or hang.", "href": "/category/illustrations-on-tile/", "ex": [{"slug": "parade-cafe-framed-tile", "name": "Parade Cafe Framed Tile", "img": "/uploads/2017/08/Koshys-F.webp"}, {"slug": "bangalore-club-framed-tile", "name": "Bangalore Club Framed Tile", "img": "/uploads/2017/08/BangClub-F-1.webp"}, {"slug": "russel-market-framed-tile", "name": "Russel Market Framed Tile", "img": "/uploads/2017/08/Russel-F.webp"}]}, {"icon": "plaque", "name": "Plaques", "desc": "Compact wall plaques of the best-loved corners.", "href": "/category/plaques/", "ex": [{"slug": "bangalore-morphed-series-mounted", "name": "Bangalore Morphed Series Mounted", "img": "/uploads/2017/03/Morphing-ALLRevised.webp"}, {"slug": "channa-sing-wallah-plaque", "name": "Channa Sing Wallah Plaque", "img": "/uploads/2017/03/Channa-Sing-Wallah-new.webp"}, {"slug": "amby-plaques-full-series", "name": "Amby Plaques Full Series", "img": "/uploads/2017/03/Ambyallplaque.webp"}]}, {"icon": "scroll", "name": "Posters", "desc": "Large-format posters of the classics.", "href": "/category/posters/", "ex": [{"slug": "amchi-mumbai", "name": "Amchi Mumbai", "img": "/uploads/2017/03/AmchiMumbaiPoster.webp"}, {"slug": "shineboards-1", "name": "Shineboards 1", "img": "/uploads/2017/03/Shineboard1-Top.webp"}, {"slug": "shineboards-2", "name": "Shineboards 2", "img": "/uploads/2017/03/A5.webp"}]}, {"icon": "book", "name": "Books", "desc": "Coffee-table books to drift through, cover to cover.", "href": "/category/coffee-table-books/", "ex": [{"slug": "bangalore-swinging-in-the-70s", "name": "Bangalore: Swinging in the 70s", "img": "/uploads/2017/03/swingingcov.webp"}, {"slug": "shineboard-arts-for-tamepass", "name": "Shineboard Arts: For Tamepass", "img": "/uploads/2017/03/Tamepass-Bookcover.webp"}, {"slug": "on-a-high-note", "name": "On a High Note", "img": "/uploads/2017/03/Highnote.webp"}]}, {"icon": "bag", "name": "Carriables & Gifts", "desc": "Bags, coasters, paperweights and small delights.", "href": "/category/merchandise/", "ex": [{"slug": "parade-cafe-slingbag", "name": "Parade Cafe Slingbag", "img": "/uploads/2017/03/KoshysFinal3.webp"}, {"slug": "jackals-wedding-slingbag", "name": "Jackals Wedding Slingbag", "img": "/uploads/2017/03/JacklsweddingFinal3.webp"}, {"slug": "good-manners-slingbag", "name": "Good Manners Slingbag", "img": "/uploads/2017/03/GoodmannersFinal3.webp"}]}];
const jsonld = [organizationSchema(Astro.site), websiteSchema(Astro.site)];
---

<BaseLayout title="Watercolours of a city that was" description={SITE_DESCRIPTION} preloadImage="/uploads/banner/goodegg-poster.webp" imageAlt="A Bangalore bungalow morning by Paul Fernandes" jsonld={jsonld}>
  <!-- HERO: wide animated banner from the aPaulogy gallery -->
  <section class="container-page pt-8 pb-6">
    <div class="art-guard">
      <video
        class="w-full h-auto block"
        autoplay muted loop playsinline
        poster="/uploads/banner/goodegg-poster.webp"
        width="1400" height="565"
        aria-label="A Bangalore bungalow morning — animated watercolour by Paul Fernandes">
        <source src="/uploads/banner/goodegg.webm" type="video/webm" />
        <source src="/uploads/banner/goodegg.mp4" type="video/mp4" />
        <img src="/uploads/banner/goodegg-poster.webp" alt="A Bangalore bungalow morning by Paul Fernandes" class="w-full h-auto" />
      </video>
    </div>
  </section>
    </div>
  </section>

  <!-- TRUST STRIP -->
  <section class="bg-black text-white mt-8">
    <div class="container-page py-3.5 flex flex-wrap justify-center items-center gap-x-8 gap-y-1.5 text-[0.68rem] tracking-[0.18em] uppercase" style="font-family:var(--font-sans)">
      <span class="flex items-center gap-2"><Icon name="truck" size={15} /> Shipped across India &amp; worldwide</span>
      <span class="opacity-40" aria-hidden="true">/</span>
      <span class="flex items-center gap-2"><Icon name="frame" size={15} /> From aPaulogy Gallery</span>
      <span class="opacity-40" aria-hidden="true">/</span>
      <span class="flex items-center gap-2"><Icon name="shield" size={15} /> Secure checkout</span>
    </div>
  </section>

  <!-- SHOP BY MEDIUM -->
  <section class="container-page pt-14 pb-4">
    <div class="text-center max-w-xl mx-auto">
      <p class="eyebrow">Choose your medium</p>
      <h2 class="text-4xl sm:text-5xl mt-2">The art, your way</h2>
      <p class="mt-4 text-[var(--color-ink-soft)]">The same curious illustrations, at home on paper, tile, plaque and more.</p>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-3 gap-5 mt-10">
      {mediums.map((m) => (
        <a href={m.href} class="group border border-[var(--color-line)] hover:border-[var(--color-ink)] transition-colors p-6 flex flex-col items-start gap-3">
          <span class="w-12 h-12 grid place-items-center border border-[var(--color-ink)] group-hover:bg-black group-hover:text-white transition-colors">
            <Icon name={m.icon} size={24} stroke={1.3} />
          </span>
          <span class="text-2xl" style="font-family:var(--font-display)">{m.name}</span>
          <span class="text-sm text-[var(--color-muted)]" style="font-family:var(--font-sans)">{m.desc}</span>
          {m.ex && m.ex.length > 0 && (
            <span class="medium-ex mt-1 w-full aspect-[16/9] overflow-hidden bg-white relative" data-count={m.ex.length}>
              {m.ex.map((e, i) => (
                <img src={e.img} alt={e.name} loading="lazy"
                  class="medium-ex-img absolute inset-0 w-full h-full object-contain"
                  style={`opacity:${i === 0 ? 1 : 0}`} />
              ))}
            </span>
          )}
          <span class="mt-auto pt-1 inline-flex items-center gap-1.5 text-[0.7rem] uppercase tracking-[0.14em] font-semibold" style="font-family:var(--font-sans)">Browse <Icon name="arrowRight" size={13} /></span>
        </a>
      ))}
    </div>
    <script is:inline>(function(){
      function cycle(){
        document.querySelectorAll('.medium-ex').forEach(function(box, k){
          var imgs = box.querySelectorAll('.medium-ex-img'); if(imgs.length<2) return;
          var idx = 0;
          setInterval(function(){
            imgs[idx].style.opacity = '0';
            idx = (idx+1) % imgs.length;
            imgs[idx].style.opacity = '1';
          }, 2600 + k*450); /* out of sync per card */
        });
      }
      if(document.readyState!=='loading') cycle(); else document.addEventListener('DOMContentLoaded', cycle);
      document.addEventListener('astro:page-load', cycle);
    })();</script>
  </section>


  <!-- Best loved -->
  <ProductSlider title="Best loved" href="/store/" icon="frame" products={featured} />

  <!-- Collection shelves (match the WordPress homepage grids) -->
  {shelves.map((s) => (
    <ProductSlider title={s.title} href={`/category/${s.slug}/`} icon={s.icon} products={s.products} />
  ))}

  <!-- FOLLOW ALONG (compact) -->
  <section class="bg-black text-white mt-16">
    <div class="container-page py-9 flex flex-col sm:flex-row items-center justify-between gap-6 text-center sm:text-left">
      <div>
        <p class="eyebrow !text-white/60">From aPaulogy Gallery</p>
        <h2 class="text-3xl sm:text-4xl mt-1.5">Follow along</h2>
        <p class="mt-2 text-white/70 max-w-md text-sm">New pieces, works in progress and the odd story — on Instagram and Facebook.</p>
      </div>
      <div class="flex flex-wrap items-center justify-center gap-3 shrink-0">
        {SOCIALS.map((s) => (
          <a href={s.href} rel="noopener" target="_blank" aria-label={`aPaulogy on ${s.name}`}
            class="flex items-center gap-2.5 border border-white/35 px-5 py-3 hover:bg-white hover:text-black transition-colors">
            <Icon name={s.icon} size={20} stroke={1.5} />
            <span class="text-[0.74rem] uppercase tracking-[0.15em] font-semibold" style="font-family:var(--font-sans)">{s.handle}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- STORY -->
  <section class="container-page py-16 grid lg:grid-cols-2 gap-14 items-center border-t border-[var(--color-line)] mt-8">
    <div class="frame art-guard">
      <img src="/uploads/2017/03/apaulogyCoffeeHouse-WITHWatermark.webp" alt="Indian Coffee House" class="protected w-full h-auto object-contain art-pad" width="576" height="470" loading="lazy" />
    </div>
    <div class="max-w-lg">
      <p class="eyebrow">The story</p>
      <h2 class="text-4xl sm:text-5xl mt-2">An ‘ology on the life &amp; times of Bangalore</h2>
      <p class="mt-6 text-[var(--color-ink-soft)]">
        aPaulogy is the gallery of cartoonist and watercolourist Paul Fernandes. Sixty
        illustrations trace a city of monkey-topped bungalows, shaded avenues, and the
        cafes and characters that gave old Bangalore its charm — with detours through
        vintage Mumbai and sunlit Goa.
      </p>
      <a href="/about-us/" class="btn btn-outline mt-8 gap-2">Read our story <Icon name="arrowRight" size={15} /></a>
    </div>
  </section>
</BaseLayout>
