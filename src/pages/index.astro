---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import ArtPlaceholder from '../components/ArtPlaceholder.astro';
import { getFeaturedProducts, getTopCategories, getProductsByCategory } from '../lib/catalog';
import { organizationSchema, websiteSchema, SITE_DESCRIPTION } from '../lib/seo';

const featured = getFeaturedProducts(8);
const collections = [
  { slug: 'bangalore-70s', name: 'Bangalore in the 70s', blurb: 'The bars, bungalows and tree-lined avenues of a gentler city.', seed: 'bangalore-club' },
  { slug: 'vintage-mumbai', name: 'Vintage Mumbai', blurb: 'Bombay bazaars, cafes and sea-facing verandahs.', seed: 'chor-bazaar' },
  { slug: 'goa', name: 'Goa', blurb: 'Whitewashed churches, tavernas and Susegad afternoons.', seed: 'goan-taverna' },
];

const jsonld = [organizationSchema(Astro.site), websiteSchema(Astro.site)];
---

<BaseLayout title="Watercolours of a city that was" description={SITE_DESCRIPTION} jsonld={jsonld}>
  <!-- HERO -->
  <section class="relative overflow-hidden border-b border-[var(--color-line)]">
    <div class="container-page grid lg:grid-cols-2 gap-10 items-center py-16 lg:py-24">
      <div class="max-w-xl">
        <p class="eyebrow">The aPaulogy Gallery · Bengaluru</p>
        <h1 class="mt-4 text-5xl sm:text-6xl lg:text-7xl leading-[1.02]">
          Watercolours of<br />a city that was
        </h1>
        <p class="mt-6 text-lg text-[var(--color-ink-soft)] max-w-md">
          Signed reproductions of Paul Fernandes’ illustrations — the bars, bungalows and
          back-lanes of 1970s Bangalore, vintage Mumbai and Goa. Each print personally signed
          before it ships.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/store/" class="btn btn-primary">Explore the store</a>
          <a href="/category/bangalore-70s/" class="btn btn-outline">Bangalore in the 70s</a>
        </div>
      </div>

      <div class="relative">
        <div class="grid grid-cols-2 gap-4">
          <div class="rounded-sm shadow-[var(--shadow-frame)] rotate-[-2deg]">
            <ArtPlaceholder seed="bangalore-palace" label="Bangalore Palace" ratio="3 / 4" />
          </div>
          <div class="rounded-sm shadow-[var(--shadow-frame)] rotate-[1.5deg] mt-8">
            <ArtPlaceholder seed="chor-bazaar" label="Chor Bazaar" ratio="3 / 4" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- MARQUEE / TRUST -->
  <section class="bg-[var(--color-heritage)] text-[#f2e9d8]">
    <div class="container-page py-4 flex flex-wrap justify-center gap-x-10 gap-y-2 text-[0.72rem] tracking-[0.18em] uppercase" style="font-family:var(--font-sans)">
      <span>✦ Personally signed by the artist</span>
      <span>✦ Museum-quality giclée prints</span>
      <span>✦ Shipped across India & worldwide</span>
    </div>
  </section>

  <!-- COLLECTIONS -->
  <section class="container-page py-20">
    <div class="flex items-end justify-between gap-4 mb-10">
      <div>
        <p class="eyebrow">Collections</p>
        <h2 class="text-4xl mt-2">Choose your era</h2>
      </div>
      <a href="/store/" class="hidden sm:inline text-sm underline underline-offset-4 hover:text-[var(--color-terracotta)]">View all</a>
    </div>
    <div class="grid sm:grid-cols-3 gap-6">
      {collections.map((c) => (
        <a href={`/category/${c.slug}/`} class="group block">
          <div class="rounded-sm overflow-hidden shadow-[var(--shadow-frame)]">
            <div class="transition-transform duration-500 group-hover:scale-[1.04]">
              <ArtPlaceholder seed={c.seed} label={c.name} ratio="5 / 4" />
            </div>
          </div>
          <h3 class="text-2xl mt-4 group-hover:text-[var(--color-terracotta)] transition-colors">{c.name}</h3>
          <p class="text-[var(--color-ink-soft)] text-sm mt-1">{c.blurb}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- FEATURED PRODUCTS -->
  <section class="bg-[var(--color-paper-deep)] border-y border-[var(--color-line)]">
    <div class="container-page py-20">
      <div class="flex items-end justify-between gap-4 mb-10">
        <div>
          <p class="eyebrow">Best loved</p>
          <h2 class="text-4xl mt-2">Featured prints & pieces</h2>
        </div>
        <a href="/store/" class="hidden sm:inline text-sm underline underline-offset-4 hover:text-[var(--color-terracotta)]">Shop all</a>
      </div>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8">
        {featured.map((p) => <ProductCard product={p} />)}
      </div>
    </div>
  </section>

  <!-- STORY -->
  <section class="container-page py-20 grid lg:grid-cols-2 gap-12 items-center">
    <div class="rounded-sm overflow-hidden shadow-[var(--shadow-frame)]">
      <ArtPlaceholder seed="coffee-house" label="Indian Coffee House" ratio="4 / 3" />
    </div>
    <div class="max-w-lg">
      <p class="eyebrow">The story</p>
      <h2 class="text-4xl mt-2">An ‘ology on the life & times of Bangalore</h2>
      <p class="mt-5 text-[var(--color-ink-soft)]">
        aPaulogy is the gallery of cartoonist and watercolourist Paul Fernandes. Sixty
        illustrations trace a city of monkey-topped bungalows, shaded avenues, and the
        cafes and characters that gave old Bangalore its charm — with detours through
        vintage Mumbai and sunlit Goa.
      </p>
      <p class="mt-4 text-[var(--color-ink-soft)]">
        Every reproduction is printed to archival standards and personally signed by the
        artist before it makes its way to your wall.
      </p>
      <a href="/about-us/" class="btn btn-outline mt-7">Read our story</a>
    </div>
  </section>
</BaseLayout>
