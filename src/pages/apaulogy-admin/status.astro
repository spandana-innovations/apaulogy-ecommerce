---
export const prerender = false;
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getStats, systemStatus, readsToday } from '../../lib/admin-data';
const env = (Astro.locals as any)?.runtime?.env ?? {};
const base = await getStats(env);
const status = await systemStatus(env);
const reads = await readsToday(env);
const D1_FREE_READS = 5_000_000;     // Cloudflare D1 free tier: 5M row reads/day
const D1_FREE_WRITES = 100_000;      // 100k writes/day
const pct = Math.min(100, Math.round((reads / D1_FREE_READS) * 100));
const level = status.d1Limited ? 100 : pct;
const barColor = level >= 90 ? 'var(--bad)' : level >= 75 ? 'var(--warn)' : 'var(--ok)';
const missing = (status as any).missingTables || [];
---
<AdminLayout title="Status" active="status" dbBound={base.dbBound}>
  {missing.length > 0 && (
    <div class="banner" style="background:var(--bad-bg);border-color:var(--bad);color:var(--bad)">
      <strong>Some features need a database update.</strong> These tables are missing: <code>{missing.join(', ')}</code>.
      Run <code>db/migrations-admin.sql</code> in your Cloudflare D1 Console (it's safe to re-run) to enable
      <strong> Site analytics</strong> and the <strong>read-usage gauge</strong>. Until then those will show empty.
    </div>
  )}
  {(status.d1Limited || level >= 90) && (
    <div class="lockout">
      <strong>Database read limit reached.</strong> The admin can't load live data until the free-tier quota resets.
      <span id="reset-timer" class="rt"></span>
      <div class="muted" style="margin-top:.4rem;font-size:.8rem">Upgrade to the Workers Paid plan (US $5/mo) to remove this limit — Cloudflare → Workers &amp; Pages → Plans.</div>
    </div>
  )}
  {!status.d1Limited && level >= 75 && level < 90 && (
    <div class="banner">⚠︎ You've used about <strong>{level}%</strong> of today's free database read allowance. Heavy admin use may pause live data before midnight UTC. Consider the $5/mo Workers Paid plan to remove the limit.</div>
  )}

  <div style="display:grid;grid-template-columns:1fr 1fr;gap:1.6rem;align-items:start;max-width:1000px">
    <section class="card" style="padding:1.4rem">
      <h2 style="font-size:1.1rem;font-weight:700;margin:0 0 1rem">Services</h2>
      <ul class="svc">
        {status.services.map((s:any)=>(
          <li><span class={`dot ${s.ok?'up':'down'}`}></span><span class="svc-name">{s.name}</span><span class="svc-note muted">{s.note}</span></li>
        ))}
      </ul>
    </section>

    <section class="card" style="padding:1.4rem">
      <h2 style="font-size:1.1rem;font-weight:700;margin:0 0 .3rem">D1 database — free tier</h2>
      <p class="muted" style="font-size:.78rem;margin:0 0 1rem">Estimated usage today · resets at midnight UTC</p>
      <div class="gauge-row">
        <div class="gauge-label"><span>Row reads</span><span>{reads.toLocaleString()} / {D1_FREE_READS.toLocaleString()}</span></div>
        <div class="gauge"><span style={`width:${Math.max(2,level)}%;background:${barColor}`}></span></div>
        <div class="gauge-pct" style={`color:${barColor}`}>{level}%</div>
      </div>
      <p class="muted" style="font-size:.75rem;margin-top:1rem">Reads are an estimate tracked in-app. The exact figure lives in your Cloudflare dashboard. Writes limit: {D1_FREE_WRITES.toLocaleString()}/day.</p>
    </section>
  </div>

  <style is:global>
    .lockout{ background:var(--bad-bg); border:1px solid var(--bad); color:var(--bad); border-radius:12px; padding:1rem 1.2rem; margin-bottom:1.4rem; font-size:.9rem; }
    .lockout .rt{ display:block; font-family:ui-monospace,monospace; font-size:1.3rem; margin-top:.4rem; color:var(--ink); }
    .svc{ list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:.1rem; }
    .svc li{ display:flex; align-items:center; gap:.7rem; padding:.6rem 0; border-bottom:1px solid var(--line); }
    .svc li:last-child{ border-bottom:0; }
    .dot{ width:9px; height:9px; border-radius:50%; flex:none; }
    .dot.up{ background:var(--ok); box-shadow:0 0 0 3px var(--ok-bg); }
    .dot.down{ background:var(--bad); box-shadow:0 0 0 3px var(--bad-bg); }
    .svc-name{ font-weight:500; } .svc-note{ margin-left:auto; font-size:.8rem; }
    .gauge-row{ }
    .gauge-label{ display:flex; justify-content:space-between; font-size:.8rem; color:var(--muted); margin-bottom:.4rem; }
    .gauge{ height:12px; background:var(--panel-2); border:1px solid var(--line); border-radius:20px; overflow:hidden; }
    .gauge span{ display:block; height:100%; border-radius:20px; transition:width .4s; }
    .gauge-pct{ text-align:right; font-weight:700; font-size:.9rem; margin-top:.3rem; }
  </style>
  <script>
    // Countdown to midnight UTC (D1 quota reset)
    (function(){
      var el=document.getElementById('reset-timer'); if(!el) return;
      function tick(){ var now=new Date(); var next=new Date(Date.UTC(now.getUTCFullYear(),now.getUTCMonth(),now.getUTCDate()+1,0,0,0)); var d=next-now; var h=Math.floor(d/3.6e6), m=Math.floor(d%3.6e6/6e4), s=Math.floor(d%6e4/1000); el.textContent='Resets in '+String(h).padStart(2,'0')+':'+String(m).padStart(2,'0')+':'+String(s).padStart(2,'0'); }
      tick(); setInterval(tick,1000);
    })();
  </script>
</AdminLayout>
