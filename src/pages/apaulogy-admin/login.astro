---
export const prerender = false;
import { readCookie, verifySession, ADMIN_COOKIE } from '../../lib/admin-auth';
const env = (Astro.locals as any)?.runtime?.env ?? {};
// already signed in? go through
if (await verifySession(readCookie(Astro.request, ADMIN_COOKIE), env)) return Astro.redirect('/apaulogy-admin/');
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex,nofollow" />
  <title>Sign in · aPaulogy</title>
  <style>
    *{box-sizing:border-box} body{margin:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;
      background:#f6f4ef;color:#14120f;display:grid;place-items:center;min-height:100vh}
    .box{background:#fff;border:1px solid #e6e3dc;border-radius:6px;width:360px;max-width:92vw;padding:2.2rem 2rem;box-shadow:0 12px 40px rgba(0,0,0,.12)}
    .logo{display:flex;align-items:center;gap:.6rem;justify-content:center;margin-bottom:1.1rem}
    .logo img{width:36px;height:36px} .logo b{font-family:Georgia,serif;font-size:1.3rem}
    h1{font-family:Georgia,serif;font-weight:600;font-size:1.3rem;text-align:center;margin:.2rem 0 .3rem}
    .sub{text-align:center;font-size:.82rem;color:#8a847b;margin:0 0 1.4rem}
    label{display:block;font-size:.7rem;text-transform:uppercase;letter-spacing:.09em;color:#6b655c;margin:.9rem 0 .35rem}
    input[type=text],input[type=password]{width:100%;padding:.7rem .85rem;border:1px solid #cfccc4;border-radius:4px;font:inherit}
    input:focus{outline:none;border-color:#111;box-shadow:0 0 0 1px #111}
    button.submit{width:100%;margin-top:1.5rem;padding:.75rem;background:#111;color:#fff;border:0;border-radius:4px;font-size:.92rem;cursor:pointer;transition:background .15s}
    button.submit:hover:not(:disabled){background:#000}
    button.submit:disabled{background:#c9c5bc;cursor:not-allowed}
    .err{color:#b00020;font-size:.8rem;margin-top:.8rem;min-height:1em;text-align:center}
    .foot{margin-top:1.3rem;text-align:center;font-size:.78rem}
    .foot a{color:#111}

    /* slide-to-verify captcha (no images) */
    .slide{margin-top:1.2rem;position:relative;height:46px;background:#f1eee7;border:1px solid #ddd7cc;border-radius:24px;overflow:hidden;user-select:none;touch-action:none}
    .slide .track-label{position:absolute;inset:0;display:grid;place-items:center;font-size:.8rem;color:#8a847b;pointer-events:none;transition:opacity .2s}
    .slide .fill{position:absolute;left:0;top:0;bottom:0;width:44px;background:#111;opacity:.08;border-radius:24px}
    .slide .handle{position:absolute;left:2px;top:2px;width:42px;height:40px;background:#111;color:#fff;border-radius:20px;display:grid;place-items:center;cursor:grab;box-shadow:0 2px 6px rgba(0,0,0,.2)}
    .slide.done{background:#e2efe3;border-color:#bcd9be}
    .slide.done .handle{background:#1f6b2e;cursor:default}
    .slide.done .track-label{opacity:0}
    .slide .ok{position:absolute;inset:0;display:grid;place-items:center;font-size:.82rem;color:#1f6b2e;opacity:0;transition:opacity .2s}
    .slide.done .ok{opacity:1}
  </style>
</head>
<body>
  <form class="box" id="f">
    <div class="logo"><img src="/favicon.svg" alt="" /><b>aPaulogy</b></div>
    <h1>Welcome back</h1>
    <p class="sub">Sign in to your account</p>

    <label for="u">Username or email</label>
    <input id="u" name="user" type="text" autocomplete="username" autofocus />
    <label for="p">Password</label>
    <input id="p" name="pass" type="password" autocomplete="current-password" />

    <div class="slide" id="slide" role="slider" aria-label="Slide to verify you are human" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" tabindex="0">
      <span class="fill" id="fill"></span>
      <span class="track-label">Slide to verify →</span>
      <span class="ok">✓ Verified</span>
      <span class="handle" id="handle">›</span>
    </div>
    <input type="hidden" name="verified" id="verified" value="0" />

    <button type="submit" class="submit" id="go" disabled>Sign in</button>
    <p class="err" id="err"></p>
    <p class="foot"><a href="#" id="forgot">Forgot your password?</a></p>
  </form>

  <script>
    // ---- slide to verify ----
    const slide=document.getElementById('slide'), handle=document.getElementById('handle'), fill=document.getElementById('fill');
    const verified=document.getElementById('verified'), go=document.getElementById('go');
    let dragging=false, done=false, startX=0, x=0;
    const maxX=()=> slide.clientWidth - handle.clientWidth - 4;
    function move(px){ x=Math.max(0,Math.min(maxX(),px)); handle.style.left=(2+x)+'px'; fill.style.width=(44+x)+'px'; slide.setAttribute('aria-valuenow', Math.round(x/maxX()*100)); }
    function finish(ok){ if(ok){ done=true; move(maxX()); slide.classList.add('done'); handle.textContent='✓'; verified.value='1'; go.disabled=false; } else { move(0); } }
    function down(e){ if(done)return; dragging=true; startX=(e.touches?e.touches[0].clientX:e.clientX)-x; handle.style.cursor='grabbing'; }
    function mv(e){ if(!dragging||done)return; const cx=(e.touches?e.touches[0].clientX:e.clientX); move(cx-startX); if(e.cancelable)e.preventDefault(); }
    function up(){ if(!dragging||done)return; dragging=false; handle.style.cursor='grab'; finish(x>=maxX()-4); }
    handle.addEventListener('mousedown',down); window.addEventListener('mousemove',mv); window.addEventListener('mouseup',up);
    handle.addEventListener('touchstart',down,{passive:false}); window.addEventListener('touchmove',mv,{passive:false}); window.addEventListener('touchend',up);
    slide.addEventListener('keydown',(e)=>{ if(done)return; if(e.key==='ArrowRight'||e.key==='Enter'||e.key===' '){ finish(true); e.preventDefault(); } });

    // ---- submit ----
    const f=document.getElementById('f');
    f.addEventListener('submit', async (e)=>{
      e.preventDefault();
      const err=document.getElementById('err'); err.textContent='';
      if(verified.value!=='1'){ err.textContent='Please slide to verify first.'; return; }
      go.disabled=true; go.textContent='Signing in…';
      const body={ user:(document.getElementById('u')).value.trim(), pass:(document.getElementById('p')).value, verified:'1' };
      try{
        const r=await fetch('/api/admin/login',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});
        const d=await r.json().catch(()=>({}));
        if(r.ok && d.ok){ location.href = d.redirect || '/apaulogy-admin/'; return; }
        err.textContent = d.error || 'Incorrect username or password.';
      }catch{ err.textContent='Network error. Please try again.'; }
      go.disabled=false; go.textContent='Sign in';
    });
    document.getElementById('forgot').addEventListener('click',(e)=>{ e.preventDefault();
      document.getElementById('err').textContent='Password help: contact your administrator to reset it.'; });
  </script>
</body>
</html>
