---
export const prerender = false;
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getStats, getSetting } from '../../lib/admin-data';
const env = (Astro.locals as any)?.runtime?.env ?? {};
const stats = await getStats(env);
const rzpIdEnv = !!env.RAZORPAY_KEY_ID;
const rzpId = (await getSetting(env, 'razorpay_key_id')) || '';
const rzpTestId = (await getSetting(env, 'razorpay_test_key_id')) || '';
const hasSecret = !!(env.RAZORPAY_KEY_SECRET) || !!(await getSetting(env, 'razorpay_key_secret'));
const hasTestSecret = !!(await getSetting(env, 'razorpay_test_key_secret'));
// PhonePe (v2) — pre-fill non-secret fields so they persist visibly
const ppCid = (await getSetting(env, 'phonepe_client_id')) || '';
const ppCver = (await getSetting(env, 'phonepe_client_version')) || '';
const ppHasSecret = !!(await getSetting(env, 'phonepe_client_secret'));
const ppTestCid = (await getSetting(env, 'phonepe_test_client_id')) || '';
const ppTestCver = (await getSetting(env, 'phonepe_test_client_version')) || '';
const ppHasTestSecret = !!(await getSetting(env, 'phonepe_test_client_secret'));
const reFrom = (await getSetting(env, 'from_email')) || '';
const reHasKey = !!(await getSetting(env, 'resend_key'));
const rzpVerified = (await getSetting(env, 'razorpay_verified'))==='1';
const ppVerified = (await getSetting(env, 'phonepe_verified'))==='1';
const reVerified = (await getSetting(env, 'resend_verified'))==='1';
const origin = env.SITE_URL || 'https://apaulogy.com';
import { getSiteMode } from '../../lib/admin-data';
const siteMode = await getSiteMode(env);
import { paymentMode } from '../../lib/payments';
import { systemStatus, readsToday } from '../../lib/admin-data';
const sys = await systemStatus(env);
const readsMo = await readsToday(env);
const TURSO_READS = 500_000_000;
const usagePct = Math.min(100, Math.round((readsMo / TURSO_READS) * 100));
const payMode = await paymentMode(env);
const pgDomestic = (await getSetting(env,'pg_domestic'))||'both';
const pgIntl = (await getSetting(env,'pg_international'))||'razorpay';
---
<AdminLayout title="Settings" active="settings" dbBound={stats.dbBound}>
  <div class="set-tabs" role="tablist">
    <button class="set-tab on" data-tab="keys" type="button">Keys</button>
    <button class="set-tab" data-tab="modes" type="button">Site modes</button>
    <button class="set-tab" data-tab="resources" type="button">Resources</button>
    <button class="set-tab" data-tab="admins" type="button">Admin users</button>
    <button class="set-tab" data-tab="status" type="button">Status</button>
  </div>
  <div class="settings-grid">
    <!-- Payment mode -->
    <section data-panel="keys" class="card" style="padding:1.4rem;grid-column:1/-1">
      <h2 style="font-family:var(--font-display);font-size:1.4rem;margin:0 0 .3rem">Payment mode</h2>
      <p class="muted" style="font-family:var(--font-sans);font-size:.82rem;margin:0 0 1rem">Test uses sandbox keys (no real charges). Live accepts real payments.</p>
      <div class="pay-toggle">
        <span class={payMode==='test' ? 'pt-lbl on' : 'pt-lbl'}>Test</span>
        <button type="button" id="pay-switch" class={`pt-switch ${payMode==='live' ? 'live' : ''}`} role="switch" aria-checked={payMode==='live'} aria-label="Toggle live/test payments"><span class="pt-knob"></span></button>
        <span class={payMode==='live' ? 'pt-lbl on live' : 'pt-lbl'}>Live</span>
        <input type="hidden" id="pay-mode-val" value={payMode} />
        <span class="muted" id="paymode-msg" style="font-size:.78rem;margin-left:.8rem"></span>
      </div>
      <div style="margin-top:1.4rem;display:grid;grid-template-columns:1fr 1fr;gap:1rem;max-width:520px">
        <label class="fld">Domestic (India) gateway
          <select id="pg-dom">
            <option value="both" selected={pgDomestic==='both'}>Both (customer chooses)</option>
            <option value="razorpay" selected={pgDomestic==='razorpay'}>Razorpay only</option>
            <option value="phonepe" selected={pgDomestic==='phonepe'}>PhonePe only</option>
          </select>
        </label>
        <label class="fld">International gateway
          <select id="pg-intl">
            <option value="razorpay" selected={pgIntl==='razorpay'}>Razorpay only</option>
            <option value="both" selected={pgIntl==='both'}>Both</option>
            <option value="phonepe" selected={pgIntl==='phonepe'}>PhonePe only</option>
          </select>
        </label>
      </div>
      <div style="margin-top:.8rem"><button class="btn" id="pg-save" style="background:var(--gold);color:#0a0f16;font-weight:600">Save gateway routing</button> <span class="muted" id="pg-msg" style="font-size:.78rem"></span></div>
    </section>

    <!-- Razorpay -->
    <section data-panel="keys" class="card" style="padding:1.4rem">
      <h2 style="font-family:var(--font-display);font-size:1.4rem;margin:0 0 .3rem">Razorpay payment keys {rzpId ? <span class={rzpVerified?'key-badge ok':'key-badge'}>{rzpVerified?'✓ Live keys verified':'Keys present · not tested'}</span> : ''}</h2>
      <p class="muted" style="font-family:var(--font-sans);font-size:.82rem;margin:0 0 1rem">
        Enter your live or test keys from the Razorpay dashboard. Stored in your database and used at checkout.
        {rzpIdEnv && ' Environment keys are set and take priority over these.'}
      </p>
      <div style="display:grid;gap:.8rem;font-family:var(--font-sans);font-size:.85rem">
        <label class="fld">Key ID<input id="rzp-id" autocomplete="off" autocapitalize="off" spellcheck="false" data-lpignore="true" data-form-type="other" value={rzpId} placeholder="rzp_live_… or rzp_test_…"/></label>
        <label class="fld">Key Secret<input id="rzp-secret" autocomplete="off" autocapitalize="off" spellcheck="false" data-lpignore="true" data-form-type="other" type="password" placeholder={hasSecret ? '•••••••• (saved — leave blank to keep)' : 'Enter key secret'}/></label>
        <div style="border-top:1px solid var(--line);margin:.6rem 0;padding-top:.6rem"></div>
        <label class="fld">Test Key ID <span class="muted">(rzp_test_…)</span><input id="rzp-test-id" autocomplete="off" autocapitalize="off" spellcheck="false" data-lpignore="true" data-form-type="other" value={rzpTestId} placeholder="rzp_test_…"/></label>
        <label class="fld">Test Key Secret<input id="rzp-test-secret" autocomplete="off" autocapitalize="off" spellcheck="false" data-lpignore="true" data-form-type="other" type="password" placeholder="Leave blank to keep"/></label>
        <label class="fld">Webhook Secret <span class="muted">(optional)</span><input id="rzp-webhook" autocomplete="off" autocapitalize="off" spellcheck="false" data-lpignore="true" data-form-type="other" type="password" placeholder="Leave blank to keep"/></label>
        <div class="webhook-row"><span class="wh-label">Webhook URL — paste into Razorpay Dashboard → Webhooks</span>
          <code class="wh-url" id="rzp-wh">{origin}/api/razorpay-webhook</code>
          <button type="button" class="btn wh-copy" data-copy="rzp-wh">Copy</button>
          <span class="muted" style="font-size:.72rem">Events: payment.captured, order.paid, payment.failed</span>
        </div>
        <div style="display:flex;gap:.6rem;align-items:center"><button class="btn" id="rzp-test">Test connection</button><button class="btn" id="rzp-save" style="background:#000;color:#fff">Save</button> <span class="muted" id="rzp-msg" style="font-size:.78rem"></span></div>
      </div>
    </section>

    <!-- PhonePe -->
    <section data-panel="keys" class="card" style="padding:1.4rem">
      <h2 style="font-family:var(--font-display);font-size:1.4rem;margin:0 0 .3rem">PhonePe payment keys {ppCid ? <span class={ppVerified?'key-badge ok':'key-badge'}>{ppVerified?'✓ Live keys verified':'Keys present · not tested'}</span> : ''}</h2>
      <p class="muted" style="font-family:var(--font-sans);font-size:.82rem;margin:0 0 1rem">PhonePe v2 Standard Checkout (OAuth). Find your Client ID &amp; Secret in the PhonePe Business Dashboard → Developer Settings. Domestic customers can pay via PhonePe; international orders always use Razorpay.</p>
      <div style="display:grid;gap:.8rem;font-family:var(--font-sans);font-size:.85rem">
        <label class="fld">Client ID<input id="pp-cid" autocomplete="off" autocapitalize="off" spellcheck="false" data-lpignore="true" data-form-type="other" value={ppCid} placeholder="e.g. SU2XXXXXXXXXXX"/></label>
        <label class="fld">Client Secret<input id="pp-csecret" autocomplete="off" autocapitalize="off" spellcheck="false" data-lpignore="true" data-form-type="other" type="password" placeholder={ppHasSecret ? '•••••••• (saved — leave blank to keep)' : 'Enter client secret'}/></label>
        <label class="fld">Client Version<input id="pp-cver" autocomplete="off" autocapitalize="off" spellcheck="false" data-lpignore="true" data-form-type="other" value={ppCver} placeholder="from your PhonePe credentials email"/></label>
        <div style="border-top:1px solid var(--line);margin:.6rem 0;padding-top:.6rem"></div>
        <label class="fld">Test Client ID <span class="muted">(sandbox)</span><input id="pp-test-cid" autocomplete="off" autocapitalize="off" spellcheck="false" data-lpignore="true" data-form-type="other" value={ppTestCid} placeholder="Sandbox client id"/></label>
        <label class="fld">Test Client Secret<input id="pp-test-csecret" autocomplete="off" autocapitalize="off" spellcheck="false" data-lpignore="true" data-form-type="other" type="password" placeholder={ppHasTestSecret ? '•••••••• (saved)' : 'Sandbox client secret'}/></label>
        <label class="fld">Test Client Version<input id="pp-test-cver" autocomplete="off" autocapitalize="off" spellcheck="false" data-lpignore="true" data-form-type="other" value={ppTestCver} placeholder="1"/></label>
        <div class="webhook-row"><span class="wh-label">Redirect / Callback URL — set in PhonePe Dashboard</span>
          <code class="wh-url" id="pp-wh">{origin}/api/phonepe-callback</code>
          <button type="button" class="btn wh-copy" data-copy="pp-wh">Copy</button>
        </div>
        <div style="display:flex;gap:.6rem;align-items:center"><button class="btn" id="pp-test">Test</button><button class="btn" id="pp-save" style="background:#000;color:#fff">Save</button> <span class="muted" id="pp-msg" style="font-size:.78rem"></span></div>
      </div>
    </section>

    <!-- Email (Resend) -->
    <section data-panel="keys" class="card" style="padding:1.4rem">
      <h2 style="font-family:var(--font-display);font-size:1.4rem;margin:0 0 .3rem">Email (Resend) {reHasKey ? <span class={reVerified?'key-badge ok':'key-badge'}>{reVerified?'✓ Verified':'Key present · not tested'}</span> : ''}</h2>
      <p class="muted" style="font-family:var(--font-sans);font-size:.82rem;margin:0 0 1rem">Order confirmations and shipping updates are sent through Resend.</p>
      <div style="display:grid;gap:.8rem;font-family:var(--font-sans);font-size:.85rem">
        <label class="fld">Resend API key<input id="re-key" autocomplete="off" autocapitalize="off" spellcheck="false" data-lpignore="true" data-form-type="other" type="password" placeholder="re_… (leave blank to keep)"/></label>
        <label class="fld">From address<input id="re-from" autocomplete="off" autocapitalize="off" spellcheck="false" data-lpignore="true" data-form-type="other" placeholder="orders@apaulogy.com"/></label>
        <div style="display:flex;gap:.6rem;align-items:center"><button class="btn" id="re-test">Test connection</button><button class="btn" id="re-save" style="background:#000;color:#fff">Save</button> <span class="muted" id="re-msg" style="font-size:.78rem"></span></div>
      </div>
    </section>

    <!-- Shortcuts -->
    <section data-panel="resources" class="card" style="padding:1.4rem">
      <h2 style="font-family:var(--font-display);font-size:1.4rem;margin:0 0 .8rem">Store configuration</h2>
      <div style="display:grid;gap:.6rem;font-family:var(--font-sans);font-size:.9rem">
        <a href="/apaulogy-admin/shipping/" class="cfg">Weight-based shipping rates <span>→</span></a>
        <a href="/apaulogy-admin/discounts/" class="cfg">Discounts &amp; coupons <span>→</span></a>
        <a href="/apaulogy-admin/free-shipping/" class="cfg">Free-shipping products <span>→</span></a>
        <a href="/apaulogy-admin/stats/" class="cfg">Sales statistics <span>→</span></a>
      </div>
    </section>

    <!-- Site modes -->
    <section data-panel="modes" class="card" style="padding:1.4rem;grid-column:1/-1">
      <h2 style="font-family:var(--font-display);font-size:1.4rem;margin:0 0 .3rem">Site mode</h2>
      <p class="muted" style="font-family:var(--font-sans);font-size:.82rem;margin:0 0 1rem">Controls what visitors see on the storefront.</p>
      <div class="mode-grid">
        <label class={`mode-opt ${siteMode==='production'?'on':''}`}><input type="radio" name="site_mode" value="production" checked={siteMode==='production'}/><strong>Production</strong><span>Live &amp; taking orders normally.</span></label>
        <label class={`mode-opt ${siteMode==='paused'?'on':''}`}><input type="radio" name="site_mode" value="paused" checked={siteMode==='paused'}/><strong>Sales paused</strong><span>Browsing works, checkout is disabled.</span></label>
        <label class={`mode-opt ${siteMode==='construction'?'on':''}`}><input type="radio" name="site_mode" value="construction" checked={siteMode==='construction'}/><strong>Construction</strong><span>Storefront shows a “back soon” page. Admin stays open.</span></label>
      </div>
      <div style="margin-top:1rem"><button class="btn" id="mode-save" style="background:var(--gold);color:#0a0f16;font-weight:600">Apply site mode</button> <span class="muted" id="mode-msg" style="font-size:.78rem"></span></div>
    </section>

    <!-- Admin users -->
    <section data-panel="admins" class="card" style="padding:1.4rem;grid-column:1/-1">
      <h2 style="font-family:var(--font-display);font-size:1.4rem;margin:0 0 .3rem">Admin users</h2>
      <p class="muted" style="font-family:var(--font-sans);font-size:.82rem;margin:0 0 1rem">Accounts that can sign in to this admin.</p>
      <table>
        <thead><tr><th>Username</th><th>Source</th></tr></thead>
        <tbody>
          <tr><td><strong>support@spnin.com</strong></td><td class="muted">Built-in</td></tr>
          <tr><td><strong>mmp</strong></td><td class="muted">Built-in</td></tr>
          {env.ADMIN_USER && <tr><td><strong>{env.ADMIN_USER}</strong></td><td class="muted">Environment secret</td></tr>}
        </tbody>
      </table>
      <p class="muted" style="font-family:var(--font-sans);font-size:.8rem;margin-top:1rem">Add or change accounts via the <code>ADMIN_ACCOUNTS</code> Cloudflare secret (format <code>user:pass,user:pass</code>). Passwords are never shown.</p>
    </section>

    <!-- System (full width) -->
    <section data-panel="resources" class="card" style="padding:1.4rem">
      <h2 style="font-family:var(--font-display);font-size:1.4rem;margin:0 0 .8rem">System</h2>
      <table>
        <tbody>
          <tr><th style="width:180px">Store</th><td>aPaulogy Gallery — Bengaluru</td></tr>
          <tr><th>Currency</th><td>INR (₹)</td></tr>
          <tr><th>Database (D1)</th><td>{stats.dbBound ? <span class="pill s-completed">Connected</span> : <span class="pill s-pending">Not connected</span>}</td></tr>
          <tr><th>Razorpay</th><td>{(rzpIdEnv||rzpId) ? <span class="pill s-completed">Configured</span> : <span class="pill s-pending">Add keys above</span>}</td></tr>
        </tbody>
      </table>
    </section>
  </div>
  <style is:global>
    .fld{display:block}.fld input{width:100%;margin-top:.25rem;padding:.5rem .6rem;border:1px solid var(--line);font:inherit}
    .cfg{display:flex;justify-content:space-between;padding:.7rem .9rem;border:1px solid var(--line);text-decoration:none;color:var(--ink)}
    .cfg:hover{background:var(--paper-deep)}
    .mode-grid{ display:grid; grid-template-columns:repeat(auto-fit,minmax(200px,1fr)); gap:.8rem; }
    .svc-list{ list-style:none; margin:0; padding:0; }
    .svc-list li{ display:flex; align-items:center; gap:.7rem; padding:.6rem 0; border-bottom:1px solid var(--line); }
    .svc-list li:last-child{ border-bottom:0; }
    .sdot{ width:9px; height:9px; border-radius:50%; }
    .sdot.up{ background:#39d98a; box-shadow:0 0 0 3px rgba(57,217,138,.14); } .sdot.down{ background:#ff7a7a; box-shadow:0 0 0 3px rgba(255,122,122,.14); }
    .sname{ font-weight:500; } .snote{ margin-left:auto; font-size:.8rem; }
    .ugauge{ height:12px; background:var(--panel-2); border:1px solid var(--line); border-radius:20px; overflow:hidden; }
    .ugauge span{ display:block; height:100%; background:var(--gold); border-radius:20px; }
    .key-badge{ font-family:var(--font-sans); font-size:.62rem; font-weight:700; letter-spacing:.04em; text-transform:uppercase; vertical-align:middle; margin-left:.6rem; padding:.22rem .55rem; border-radius:20px; background:var(--panel-2); color:var(--muted); border:1px solid var(--line-strong); }
    .key-badge.ok{ background:rgba(57,217,138,.14); color:#39d98a; border-color:rgba(57,217,138,.5); }
    .pay-toggle{ display:flex; align-items:center; gap:.7rem; }
    .pt-lbl{ font-family:var(--font-sans); font-size:.85rem; font-weight:600; color:var(--muted); }
    .pt-lbl.on{ color:var(--ink); } .pt-lbl.on.live{ color:var(--gold); }
    .pt-switch{ width:46px; height:26px; border-radius:20px; border:1px solid var(--line-strong); background:var(--panel-2); position:relative; cursor:pointer; padding:0; transition:background .15s; }
    .pt-switch.live{ background:var(--gold); border-color:var(--gold); }
    .pt-knob{ position:absolute; top:2px; left:2px; width:20px; height:20px; border-radius:50%; background:var(--ink); transition:transform .18s; }
    .pt-switch.live .pt-knob{ transform:translateX(20px); background:#0a0f16; }
    .mode-opt{ display:flex; flex-direction:column; gap:.2rem; padding:1rem; border:1px solid var(--line-strong); border-radius:8px; cursor:pointer; }
    .mode-opt.on{ border-color:var(--gold); box-shadow:0 0 0 2px var(--gold-soft); }
    .mode-opt input{ margin-bottom:.3rem; }
    .mode-opt strong{ font-size:.95rem; } .mode-opt span{ font-size:.78rem; color:var(--muted); }
  </style>
  <script>
    (function(){
      var grid=document.querySelector('.settings-grid');
      function showTab(t){ grid.className='settings-grid show-'+t; document.querySelectorAll('.set-tab').forEach(function(b){ b.classList.toggle('on', b.dataset.tab===t); }); }
      document.querySelectorAll('.set-tab').forEach(function(b){ b.addEventListener('click',function(){ showTab(b.dataset.tab); }); });
      showTab('keys');
    })();
  </script>
  <script>

    async function testKey(provider, body, msgId){
      const m=document.getElementById(msgId); m.textContent='Testing…'; m.style.color='';
      try{ const r=await fetch('/api/admin/test-key',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(Object.assign({provider},body))}); const d=await r.json();
        if(d.ok){ m.style.color='#2e8b57'; m.textContent='✓ '+(d.message||'Valid');
        var sec=m.closest('section'); var badge=sec&&sec.querySelector('.key-badge');
        if(badge){ badge.classList.add('ok'); badge.textContent='✓ Live keys verified'; }
        return true; }
        m.style.color='#c23b3b'; m.textContent='✗ '+(d.error||'Failed'); return false;
      }catch(e){ m.style.color='#c23b3b'; m.textContent='✗ Test failed'; return false; }
    }
    let rzpOK=false, ppOK=false, reOK=false;
    document.getElementById('rzp-test')?.addEventListener('click', async()=>{ rzpOK=await testKey('razorpay',{key_id:document.getElementById('rzp-id').value.trim(),key_secret:document.getElementById('rzp-secret').value},'rzp-msg'); });
    document.getElementById('pp-test')?.addEventListener('click', async()=>{ ppOK=await testKey('phonepe',{client_id:document.getElementById('pp-cid').value.trim(),client_secret:document.getElementById('pp-csecret').value,client_version:document.getElementById('pp-cver').value.trim()},'pp-msg'); });
    document.getElementById('re-test')?.addEventListener('click', async()=>{ reOK=await testKey('resend',{resend_key:document.getElementById('re-key').value},'re-msg'); });
    // reset the OK flag whenever a cred field changes (force re-test)
    ['rzp-id','rzp-secret'].forEach(id=>document.getElementById(id)?.addEventListener('input',()=>rzpOK=false));
    ['pp-cid','pp-csecret'].forEach(id=>document.getElementById(id)?.addEventListener('input',()=>ppOK=false));
    ['re-key'].forEach(id=>document.getElementById(id)?.addEventListener('input',()=>reOK=false));

    document.getElementById('rzp-save').addEventListener('click', async()=>{
      if(document.getElementById('rzp-secret').value && !rzpOK){ const m=document.getElementById('rzp-msg'); m.style.color='#c23b3b'; m.textContent='Please “Test connection” successfully before saving.'; return; }
      const msg=document.getElementById('rzp-msg'); msg.textContent='Saving…'; msg.style.color='';
      const body={ razorpay_key_id:document.getElementById('rzp-id').value.trim(),
        razorpay_key_secret:document.getElementById('rzp-secret').value,
        razorpay_webhook_secret:document.getElementById('rzp-webhook').value,
        razorpay_test_key_id:document.getElementById('rzp-test-id').value.trim(),
        razorpay_test_key_secret:document.getElementById('rzp-test-secret').value };
      const r=await fetch('/api/admin/settings',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});
      msg.textContent=r.ok?'Saved ✓':'Failed — database connected?';
    });
    async function saveSettings(body, msgId){ const m=document.getElementById(msgId); m.textContent='Saving…'; const r=await fetch('/api/admin/settings',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)}); m.textContent=r.ok?'Saved ✓':'Failed — database connected?'; }
    document.getElementById('pp-save').addEventListener('click',()=>{ if(document.getElementById('pp-csecret').value && !ppOK){ const m=document.getElementById('pp-msg'); m.style.color='#c23b3b'; m.textContent='Please test PhonePe details before saving.'; return; } saveSettings({phonepe_client_id:document.getElementById('pp-cid').value.trim(),phonepe_client_secret:document.getElementById('pp-csecret').value,phonepe_client_version:document.getElementById('pp-cver').value.trim(),phonepe_test_client_id:document.getElementById('pp-test-cid').value.trim(),phonepe_test_client_secret:document.getElementById('pp-test-csecret').value,phonepe_test_client_version:document.getElementById('pp-test-cver').value.trim()},'pp-msg'); });
    document.getElementById('pg-save')?.addEventListener('click',function(){ saveSettings({pg_domestic:document.getElementById('pg-dom').value, pg_international:document.getElementById('pg-intl').value},'pg-msg'); });
    (function(){
      var sw=document.getElementById('pay-switch');
      if(sw){ sw.addEventListener('click', function(){
        var goingLive = !sw.classList.contains('live');
        if(goingLive){
          var typed = window.prompt('You are switching to LIVE payments — real customers will be charged real money.\n\nType "live" to confirm:');
          if((typed||'').trim().toLowerCase() !== 'live'){ return; }  // abort if not confirmed
        }
        var nowLive = sw.classList.toggle('live');
        sw.setAttribute('aria-checked', String(nowLive));
        var lbls=document.querySelectorAll('.pay-toggle .pt-lbl');
        lbls.forEach(function(l){ l.classList.remove('on','live'); });
        if(nowLive){ lbls[1].classList.add('on','live'); } else { lbls[0].classList.add('on'); }
        // update the header TEST MODE pill live (no reload)
        var pill=document.querySelector('.test-pill');
        if(nowLive){ if(pill) pill.style.display='none'; }
        else { if(pill) pill.style.display=''; else { var top=document.querySelector('.top'); if(top){ var s=document.createElement('span'); s.className='test-pill'; s.textContent='TEST MODE'; top.appendChild(s);} } }
        saveSettings({payment_mode: nowLive?'live':'test'},'paymode-msg');
      }); }
    })();
    document.querySelectorAll('input[name=pay_mode]').forEach(r=>r.addEventListener('change',()=>document.querySelectorAll('input[name=pay_mode]').forEach(x=>x.closest('.mode-opt').classList.toggle('on', x.checked))));
    document.getElementById('mode-save')?.addEventListener('click',()=>{ const m=document.querySelector('input[name=site_mode]:checked'); saveSettings({site_mode:m?m.value:'production'},'mode-msg'); document.querySelectorAll('.mode-opt').forEach(o=>o.classList.toggle('on', o.querySelector('input').checked)); });
    document.querySelectorAll('input[name=site_mode]').forEach(r=>r.addEventListener('change',()=>document.querySelectorAll('.mode-opt').forEach(o=>o.classList.toggle('on', o.querySelector('input').checked))));
    document.getElementById('re-save').addEventListener('click',()=>{ if(document.getElementById('re-key').value && !reOK){ const m=document.getElementById('re-msg'); m.style.color='#c23b3b'; m.textContent='Please test the Resend key before saving.'; return; } saveSettings({resend_key:document.getElementById('re-key').value,from_email:document.getElementById('re-from').value.trim()},'re-msg'); });
    document.querySelectorAll('.wh-copy').forEach(function(b){ b.addEventListener('click',function(){ var el=document.getElementById(b.dataset.copy); navigator.clipboard.writeText(el.textContent).then(function(){ b.textContent='Copied ✓'; setTimeout(function(){b.textContent='Copy';},1500); }); }); });
  </script>
<style is:global>
  .set-tabs{ display:flex; gap:.3rem; border-bottom:1px solid var(--line); margin-bottom:1.4rem; }
  .set-tab{ padding:.6rem 1rem; background:none; border:0; border-bottom:2px solid transparent; margin-bottom:-1px; cursor:pointer;
    font-family:var(--font-sans); font-size:.86rem; font-weight:500; color:var(--muted); }
  .set-tab.on{ color:var(--ink); border-bottom-color:var(--gold); }
  .set-tab:hover{ color:var(--ink); }
  .settings-grid [data-panel]{ display:none; }
  .settings-grid.show-keys [data-panel="keys"],
  .settings-grid.show-modes [data-panel="modes"],
  .settings-grid.show-resources [data-panel="resources"],
  .settings-grid.show-admins [data-panel="admins"],
  .settings-grid.show-status [data-panel="status"]{ display:block; }
  .settings-grid{ display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1.4rem; align-items:start; max-width:1100px; }
  .settings-grid > section:first-child{ grid-column:1 / -1; }   /* Razorpay spans top */
  .settings-grid > section:last-child{ grid-column:1 / -1; }    /* System spans bottom */
  @media(max-width:820px){ .settings-grid{ grid-template-columns:1fr; } }
  .settings-grid .fld input{ border-radius:4px; }
</style>
<style is:global>
  .webhook-row{ grid-column:1/-1; display:flex; flex-wrap:wrap; align-items:center; gap:.6rem; margin-top:.3rem; padding:.7rem .8rem; background:var(--paper-deep); border:1px solid var(--line); border-radius:4px; }
  .wh-label{ width:100%; font-size:.7rem; text-transform:uppercase; letter-spacing:.08em; color:var(--muted); }
  .wh-url{ font-family:ui-monospace,Menlo,monospace; font-size:.78rem; background:var(--panel-2); color:var(--ink); border:1px solid var(--line-strong); padding:.35rem .5rem; border-radius:4px; }
</style>
