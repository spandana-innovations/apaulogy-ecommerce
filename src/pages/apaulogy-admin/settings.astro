---
export const prerender = false;
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getStats, getSetting } from '../../lib/admin-data';
const env = (Astro.locals as any)?.runtime?.env ?? {};
const stats = await getStats(env);
const rzpIdEnv = !!env.RAZORPAY_KEY_ID;
const rzpId = (await getSetting(env, 'razorpay_key_id')) || '';
const hasSecret = !!(env.RAZORPAY_KEY_SECRET) || !!(await getSetting(env, 'razorpay_key_secret'));
const origin = env.SITE_URL || 'https://apaulogy.com';
import { getSiteMode } from '../../lib/admin-data';
const siteMode = await getSiteMode(env);
const heroSpeed = Number((await getSetting(env, 'hero_speed')) || '1');
import { paymentMode } from '../../lib/payments';
const payMode = await paymentMode(env);
---
<AdminLayout title="Settings" active="settings" dbBound={stats.dbBound}>
  <div class="set-tabs" role="tablist">
    <button class="set-tab on" data-tab="keys" type="button">Keys</button>
    <button class="set-tab" data-tab="modes" type="button">Site modes</button>
    <button class="set-tab" data-tab="resources" type="button">Resources</button>
    <button class="set-tab" data-tab="admins" type="button">Admin users</button>
  </div>
  <div class="settings-grid">
    <!-- Payment mode -->
    <section data-panel="keys" class="card" style="padding:1.4rem;grid-column:1/-1">
      <h2 style="font-family:var(--font-display);font-size:1.4rem;margin:0 0 .3rem">Payment mode</h2>
      <p class="muted" style="font-family:var(--font-sans);font-size:.82rem;margin:0 0 1rem">Test mode uses sandbox keys and never charges real money. Switch to Live only when you're ready to accept real payments.</p>
      <div class="mode-grid">
        <label class={`mode-opt ${payMode==='test'?'on':''}`}><input type="radio" name="pay_mode" value="test" checked={payMode==='test'}/><strong>Test mode</strong><span>Sandbox — safe to trial checkout.</span></label>
        <label class={`mode-opt ${payMode==='live'?'on':''}`}><input type="radio" name="pay_mode" value="live" checked={payMode==='live'}/><strong>Live mode</strong><span>Real payments from real customers.</span></label>
      </div>
      <div style="margin-top:1rem"><button class="btn" id="paymode-save" style="background:var(--gold);color:#0a0f16;font-weight:600">Apply payment mode</button> <span class="muted" id="paymode-msg" style="font-size:.78rem"></span></div>
    </section>

    <!-- Razorpay -->
    <section data-panel="keys" class="card" style="padding:1.4rem">
      <h2 style="font-family:var(--font-display);font-size:1.4rem;margin:0 0 .3rem">Razorpay payment keys</h2>
      <p class="muted" style="font-family:var(--font-sans);font-size:.82rem;margin:0 0 1rem">
        Enter your live or test keys from the Razorpay dashboard. Stored in your database and used at checkout.
        {rzpIdEnv && ' Environment keys are set and take priority over these.'}
      </p>
      <div style="display:grid;gap:.8rem;font-family:var(--font-sans);font-size:.85rem">
        <label class="fld">Key ID<input id="rzp-id" value={rzpId} placeholder="rzp_live_… or rzp_test_…"/></label>
        <label class="fld">Key Secret<input id="rzp-secret" type="password" placeholder={hasSecret ? '•••••••• (saved — leave blank to keep)' : 'Enter key secret'}/></label>
        <div style="border-top:1px solid var(--line);margin:.6rem 0;padding-top:.6rem"></div>
        <label class="fld">Test Key ID <span class="muted">(rzp_test_…)</span><input id="rzp-test-id" placeholder="rzp_test_…"/></label>
        <label class="fld">Test Key Secret<input id="rzp-test-secret" type="password" placeholder="Leave blank to keep"/></label>
        <label class="fld">Webhook Secret <span class="muted">(optional)</span><input id="rzp-webhook" type="password" placeholder="Leave blank to keep"/></label>
        <div class="webhook-row"><span class="wh-label">Webhook URL — paste into Razorpay Dashboard → Webhooks</span>
          <code class="wh-url" id="rzp-wh">{origin}/api/razorpay-webhook</code>
          <button type="button" class="btn wh-copy" data-copy="rzp-wh">Copy</button>
          <span class="muted" style="font-size:.72rem">Events: payment.captured, order.paid, payment.failed</span>
        </div>
        <div style="display:flex;gap:.6rem;align-items:center"><button class="btn" id="rzp-test">Test connection</button><button class="btn" id="rzp-save" style="background:#000;color:#fff">Save keys</button> <span class="muted" id="rzp-msg" style="font-size:.78rem"></span></div>
      </div>
    </section>

    <!-- PhonePe -->
    <section data-panel="keys" class="card" style="padding:1.4rem">
      <h2 style="font-family:var(--font-display);font-size:1.4rem;margin:0 0 .3rem">PhonePe payment keys</h2>
      <p class="muted" style="font-family:var(--font-sans);font-size:.82rem;margin:0 0 1rem">Domestic customers can pay via PhonePe. International orders always use Razorpay.</p>
      <div style="display:grid;gap:.8rem;font-family:var(--font-sans);font-size:.85rem">
        <label class="fld">Merchant ID<input id="pp-mid" placeholder="e.g. M22XXXXXXXX"/></label>
        <label class="fld">Salt Key<input id="pp-salt" type="password" placeholder="Leave blank to keep"/></label>
        <label class="fld">Salt Index<input id="pp-index" placeholder="1"/></label>
        <div style="border-top:1px solid var(--line);margin:.6rem 0;padding-top:.6rem"></div>
        <label class="fld">Test Merchant ID <span class="muted">(UAT)</span><input id="pp-test-mid" placeholder="PGTESTPAYUAT"/></label>
        <label class="fld">Test Salt Key<input id="pp-test-salt" type="password" placeholder="Leave blank to keep"/></label>
        <label class="fld">Test Salt Index<input id="pp-test-index" placeholder="1"/></label>
        <div class="webhook-row"><span class="wh-label">Redirect / Callback URL — set in PhonePe Dashboard</span>
          <code class="wh-url" id="pp-wh">{origin}/api/phonepe-callback</code>
          <button type="button" class="btn wh-copy" data-copy="pp-wh">Copy</button>
        </div>
        <div style="display:flex;gap:.6rem;align-items:center"><button class="btn" id="pp-test">Test</button><button class="btn" id="pp-save" style="background:#000;color:#fff">Save PhonePe</button> <span class="muted" id="pp-msg" style="font-size:.78rem"></span></div>
      </div>
    </section>

    <!-- Email (Resend) -->
    <section data-panel="keys" class="card" style="padding:1.4rem">
      <h2 style="font-family:var(--font-display);font-size:1.4rem;margin:0 0 .3rem">Email (Resend)</h2>
      <p class="muted" style="font-family:var(--font-sans);font-size:.82rem;margin:0 0 1rem">Order confirmations and shipping updates are sent through Resend.</p>
      <div style="display:grid;gap:.8rem;font-family:var(--font-sans);font-size:.85rem">
        <label class="fld">Resend API key<input id="re-key" type="password" placeholder="re_… (leave blank to keep)"/></label>
        <label class="fld">From address<input id="re-from" placeholder="orders@apaulogy.com"/></label>
        <div style="display:flex;gap:.6rem;align-items:center"><button class="btn" id="re-test">Test connection</button><button class="btn" id="re-save" style="background:#000;color:#fff">Save email</button> <span class="muted" id="re-msg" style="font-size:.78rem"></span></div>
      </div>
    </section>

    <!-- Shortcuts -->
    <section data-panel="resources" class="card" style="padding:1.4rem">
      <h2 style="font-family:var(--font-display);font-size:1.4rem;margin:0 0 .8rem">Store configuration</h2>
      <div style="display:grid;gap:.6rem;font-family:var(--font-sans);font-size:.9rem">
        <a href="/apaulogy-admin/shipping/" class="cfg">Weight-based shipping rates <span>→</span></a>
        <a href="/apaulogy-admin/discounts/" class="cfg">Discounts &amp; coupons <span>→</span></a>
        <a href="/apaulogy-admin/free-shipping/" class="cfg">Free-shipping products <span>→</span></a>
        <a href="/apaulogy-admin/stats/" class="cfg">Sales statistics <span>→</span></a>
      </div>
    </section>

    <!-- Site modes -->
    <section data-panel="modes" class="card" style="padding:1.4rem;grid-column:1/-1">
      <h2 style="font-family:var(--font-display);font-size:1.4rem;margin:0 0 .3rem">Site mode</h2>
      <p class="muted" style="font-family:var(--font-sans);font-size:.82rem;margin:0 0 1rem">Controls what visitors see on the storefront.</p>
      <div class="mode-grid">
        <label class={`mode-opt ${siteMode==='production'?'on':''}`}><input type="radio" name="site_mode" value="production" checked={siteMode==='production'}/><strong>Production</strong><span>Live &amp; taking orders normally.</span></label>
        <label class={`mode-opt ${siteMode==='paused'?'on':''}`}><input type="radio" name="site_mode" value="paused" checked={siteMode==='paused'}/><strong>Sales paused</strong><span>Browsing works, checkout is disabled.</span></label>
        <label class={`mode-opt ${siteMode==='construction'?'on':''}`}><input type="radio" name="site_mode" value="construction" checked={siteMode==='construction'}/><strong>Construction</strong><span>Storefront shows a “back soon” page. Admin stays open.</span></label>
      </div>
      <div style="margin-top:1rem"><button class="btn" id="mode-save" style="background:var(--gold);color:#0a0f16;font-weight:600">Apply site mode</button> <span class="muted" id="mode-msg" style="font-size:.78rem"></span></div>
      <hr style="border:0;border-top:1px solid var(--line);margin:1.6rem 0" />
      <h2 style="font-family:var(--font-display);font-size:1.4rem;margin:0 0 .3rem">Homepage banner speed</h2>
      <p class="muted" style="font-family:var(--font-sans);font-size:.82rem;margin:0 0 1rem">How fast the animated hero plays. 1.0× is normal; lower is slower &amp; calmer.</p>
      <div style="display:flex;align-items:center;gap:1rem;max-width:420px">
        <input type="range" id="hero-speed" min="0.25" max="1.5" step="0.05" value={heroSpeed} style="flex:1" />
        <span id="hero-speed-val" style="font-family:var(--font-sans);font-weight:600;min-width:3.5rem;text-align:right">{heroSpeed.toFixed(2)}x</span>
      </div>
      <div style="margin-top:1rem"><button class="btn" id="hero-save" style="background:var(--gold);color:#0a0f16;font-weight:600">Apply banner speed</button> <span class="muted" id="hero-msg" style="font-size:.78rem"></span></div>
    </section>

    <!-- Admin users -->
    <section data-panel="admins" class="card" style="padding:1.4rem;grid-column:1/-1">
      <h2 style="font-family:var(--font-display);font-size:1.4rem;margin:0 0 .3rem">Admin users</h2>
      <p class="muted" style="font-family:var(--font-sans);font-size:.82rem;margin:0 0 1rem">Accounts that can sign in to this admin.</p>
      <table>
        <thead><tr><th>Username</th><th>Source</th></tr></thead>
        <tbody>
          <tr><td><strong>support@spnin.com</strong></td><td class="muted">Built-in</td></tr>
          <tr><td><strong>mmp</strong></td><td class="muted">Built-in</td></tr>
          {env.ADMIN_USER && <tr><td><strong>{env.ADMIN_USER}</strong></td><td class="muted">Environment secret</td></tr>}
        </tbody>
      </table>
      <p class="muted" style="font-family:var(--font-sans);font-size:.8rem;margin-top:1rem">Add or change accounts via the <code>ADMIN_ACCOUNTS</code> Cloudflare secret (format <code>user:pass,user:pass</code>). Passwords are never shown.</p>
    </section>

    <!-- System (full width) -->
    <section data-panel="resources" class="card" style="padding:1.4rem">
      <h2 style="font-family:var(--font-display);font-size:1.4rem;margin:0 0 .8rem">System</h2>
      <table>
        <tbody>
          <tr><th style="width:180px">Store</th><td>aPaulogy Gallery — Bengaluru</td></tr>
          <tr><th>Currency</th><td>INR (₹)</td></tr>
          <tr><th>Database (D1)</th><td>{stats.dbBound ? <span class="pill s-completed">Connected</span> : <span class="pill s-pending">Not connected</span>}</td></tr>
          <tr><th>Razorpay</th><td>{(rzpIdEnv||rzpId) ? <span class="pill s-completed">Configured</span> : <span class="pill s-pending">Add keys above</span>}</td></tr>
        </tbody>
      </table>
    </section>
  </div>
  <style is:global>
    .fld{display:block}.fld input{width:100%;margin-top:.25rem;padding:.5rem .6rem;border:1px solid var(--line);font:inherit}
    .cfg{display:flex;justify-content:space-between;padding:.7rem .9rem;border:1px solid var(--line);text-decoration:none;color:var(--ink)}
    .cfg:hover{background:var(--paper-deep)}
    .mode-grid{ display:grid; grid-template-columns:repeat(auto-fit,minmax(200px,1fr)); gap:.8rem; }
    .mode-opt{ display:flex; flex-direction:column; gap:.2rem; padding:1rem; border:1px solid var(--line-strong); border-radius:8px; cursor:pointer; }
    .mode-opt.on{ border-color:var(--gold); box-shadow:0 0 0 2px var(--gold-soft); }
    .mode-opt input{ margin-bottom:.3rem; }
    .mode-opt strong{ font-size:.95rem; } .mode-opt span{ font-size:.78rem; color:var(--muted); }
  </style>
  <script>
    (function(){
      var grid=document.querySelector('.settings-grid');
      function showTab(t){ grid.className='settings-grid show-'+t; document.querySelectorAll('.set-tab').forEach(function(b){ b.classList.toggle('on', b.dataset.tab===t); }); }
      document.querySelectorAll('.set-tab').forEach(function(b){ b.addEventListener('click',function(){ showTab(b.dataset.tab); }); });
      showTab('keys');
    })();
  </script>
  <script>

    async function testKey(provider, body, msgId){
      const m=document.getElementById(msgId); m.textContent='Testing…'; m.style.color='';
      try{ const r=await fetch('/api/admin/test-key',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(Object.assign({provider},body))}); const d=await r.json();
        if(d.ok){ m.style.color='#2e8b57'; m.textContent='✓ '+(d.message||'Valid'); return true; }
        m.style.color='#c23b3b'; m.textContent='✗ '+(d.error||'Failed'); return false;
      }catch(e){ m.style.color='#c23b3b'; m.textContent='✗ Test failed'; return false; }
    }
    let rzpOK=false, ppOK=false, reOK=false;
    document.getElementById('rzp-test')?.addEventListener('click', async()=>{ rzpOK=await testKey('razorpay',{key_id:document.getElementById('rzp-id').value.trim(),key_secret:document.getElementById('rzp-secret').value},'rzp-msg'); });
    document.getElementById('pp-test')?.addEventListener('click', async()=>{ ppOK=await testKey('phonepe',{merchant_id:document.getElementById('pp-mid').value.trim(),salt_key:document.getElementById('pp-salt').value},'pp-msg'); });
    document.getElementById('re-test')?.addEventListener('click', async()=>{ reOK=await testKey('resend',{resend_key:document.getElementById('re-key').value},'re-msg'); });
    // reset the OK flag whenever a cred field changes (force re-test)
    ['rzp-id','rzp-secret'].forEach(id=>document.getElementById(id)?.addEventListener('input',()=>rzpOK=false));
    ['pp-mid','pp-salt'].forEach(id=>document.getElementById(id)?.addEventListener('input',()=>ppOK=false));
    ['re-key'].forEach(id=>document.getElementById(id)?.addEventListener('input',()=>reOK=false));

    document.getElementById('rzp-save').addEventListener('click', async()=>{
      if(document.getElementById('rzp-secret').value && !rzpOK){ const m=document.getElementById('rzp-msg'); m.style.color='#c23b3b'; m.textContent='Please “Test connection” successfully before saving.'; return; }
      const msg=document.getElementById('rzp-msg'); msg.textContent='Saving…'; msg.style.color='';
      const body={ razorpay_key_id:document.getElementById('rzp-id').value.trim(),
        razorpay_key_secret:document.getElementById('rzp-secret').value,
        razorpay_webhook_secret:document.getElementById('rzp-webhook').value,
        razorpay_test_key_id:document.getElementById('rzp-test-id').value.trim(),
        razorpay_test_key_secret:document.getElementById('rzp-test-secret').value };
      const r=await fetch('/api/admin/settings',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});
      msg.textContent=r.ok?'Saved ✓':'Failed — database connected?';
    });
    async function saveSettings(body, msgId){ const m=document.getElementById(msgId); m.textContent='Saving…'; const r=await fetch('/api/admin/settings',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)}); m.textContent=r.ok?'Saved ✓':'Failed — database connected?'; }
    document.getElementById('pp-save').addEventListener('click',()=>{ if(document.getElementById('pp-salt').value && !ppOK){ const m=document.getElementById('pp-msg'); m.style.color='#c23b3b'; m.textContent='Please test PhonePe details before saving.'; return; } saveSettings({phonepe_merchant_id:document.getElementById('pp-mid').value.trim(),phonepe_salt_key:document.getElementById('pp-salt').value,phonepe_salt_index:document.getElementById('pp-index').value.trim(),phonepe_test_merchant_id:document.getElementById('pp-test-mid').value.trim(),phonepe_test_salt_key:document.getElementById('pp-test-salt').value,phonepe_test_salt_index:document.getElementById('pp-test-index').value.trim()},'pp-msg'); });
    document.getElementById('paymode-save')?.addEventListener('click',()=>{ const m=document.querySelector('input[name=pay_mode]:checked'); saveSettings({payment_mode:m?m.value:'test'},'paymode-msg'); document.querySelectorAll('input[name=pay_mode]').forEach(r=>r.closest('.mode-opt').classList.toggle('on', r.checked)); });
    document.querySelectorAll('input[name=pay_mode]').forEach(r=>r.addEventListener('change',()=>document.querySelectorAll('input[name=pay_mode]').forEach(x=>x.closest('.mode-opt').classList.toggle('on', x.checked))));
    document.getElementById('mode-save')?.addEventListener('click',()=>{ const m=document.querySelector('input[name=site_mode]:checked'); saveSettings({site_mode:m?m.value:'production'},'mode-msg'); document.querySelectorAll('.mode-opt').forEach(o=>o.classList.toggle('on', o.querySelector('input').checked)); });
    document.querySelectorAll('input[name=site_mode]').forEach(r=>r.addEventListener('change',()=>document.querySelectorAll('.mode-opt').forEach(o=>o.classList.toggle('on', o.querySelector('input').checked))));
    document.getElementById('re-save').addEventListener('click',()=>{ if(document.getElementById('re-key').value && !reOK){ const m=document.getElementById('re-msg'); m.style.color='#c23b3b'; m.textContent='Please test the Resend key before saving.'; return; } saveSettings({resend_key:document.getElementById('re-key').value,from_email:document.getElementById('re-from').value.trim()},'re-msg'); });
    document.querySelectorAll('.wh-copy').forEach(function(b){ b.addEventListener('click',function(){ var el=document.getElementById(b.dataset.copy); navigator.clipboard.writeText(el.textContent).then(function(){ b.textContent='Copied ✓'; setTimeout(function(){b.textContent='Copy';},1500); }); }); });
  
    (function(){
      var r=document.getElementById('hero-speed'), v=document.getElementById('hero-speed-val');
      if(r&&v){ r.addEventListener('input',function(){ v.textContent=Number(r.value).toFixed(2)+'x'; }); }
      var b=document.getElementById('hero-save');
      if(b){ b.addEventListener('click',function(){ saveSettings({hero_speed:Number(r.value)},'hero-msg'); }); }
    })();
  </script>
<style is:global>
  .set-tabs{ display:flex; gap:.3rem; border-bottom:1px solid var(--line); margin-bottom:1.4rem; }
  .set-tab{ padding:.6rem 1rem; background:none; border:0; border-bottom:2px solid transparent; margin-bottom:-1px; cursor:pointer;
    font-family:var(--font-sans); font-size:.86rem; font-weight:500; color:var(--muted); }
  .set-tab.on{ color:var(--ink); border-bottom-color:var(--gold); }
  .set-tab:hover{ color:var(--ink); }
  .settings-grid [data-panel]{ display:none; }
  .settings-grid.show-keys [data-panel="keys"],
  .settings-grid.show-modes [data-panel="modes"],
  .settings-grid.show-resources [data-panel="resources"],
  .settings-grid.show-admins [data-panel="admins"]{ display:block; }
  .settings-grid{ display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1.4rem; align-items:start; max-width:1100px; }
  .settings-grid > section:first-child{ grid-column:1 / -1; }   /* Razorpay spans top */
  .settings-grid > section:last-child{ grid-column:1 / -1; }    /* System spans bottom */
  @media(max-width:820px){ .settings-grid{ grid-template-columns:1fr; } }
  .settings-grid .fld input{ border-radius:4px; }
</style>
<style is:global>
  .webhook-row{ grid-column:1/-1; display:flex; flex-wrap:wrap; align-items:center; gap:.6rem; margin-top:.3rem; padding:.7rem .8rem; background:var(--paper-deep); border:1px solid var(--line); border-radius:4px; }
  .wh-label{ width:100%; font-size:.7rem; text-transform:uppercase; letter-spacing:.08em; color:var(--muted); }
  .wh-url{ font-family:ui-monospace,Menlo,monospace; font-size:.78rem; background:var(--panel-2); color:var(--ink); border:1px solid var(--line-strong); padding:.35rem .5rem; border-radius:4px; }
</style>
</AdminLayout>
