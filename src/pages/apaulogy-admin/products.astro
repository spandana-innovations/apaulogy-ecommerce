---
export const prerender = false;
import AdminLayout from '../../layouts/AdminLayout.astro';
import catalog from '../../data/catalog.json';
import { formatINR } from '../../lib/format';

const cat = catalog as any;
const catName: Record<string,string> = Object.fromEntries(cat.categories.map((c:any)=>[c.slug,c.name]));
const products = cat.products.map((p:any) => ({
  slug: p.slug, name: p.name, type: p.type,
  price: p.sale_price ?? p.price, basePrice: p.price, salePrice: p.sale_price ?? null, priceMax: p.price_max,
  cat: catName[p.primary_category] || p.primary_category || '—',
  img: p.images?.[0]?.url || '', variants: p.variations?.length || 0,
  featured: p.featured ? 1 : 0,
})).sort((a:any,b:any)=>a.name.localeCompare(b.name));
---
<AdminLayout title="Products" active="products">
  <div style="display:flex;gap:.8rem;align-items:center;margin-bottom:1rem;flex-wrap:wrap">
    <input id="q" placeholder="Search products…" style="flex:1;min-width:220px" />
    <span class="muted" style="font-size:.82rem" id="count">{products.length} products</span>
  </div>
  <div class="card" style="overflow:hidden">
    <table id="tbl">
      <thead><tr><th></th><th>Name</th><th>Category</th><th>Type</th><th style="text-align:right">Price</th><th style="text-align:center">Variants</th><th></th></tr></thead>
      <tbody>
        {products.map((p:any) => (
          <tr data-name={p.name.toLowerCase()} data-cat={p.cat.toLowerCase()}>
            <td style="width:52px">{p.img ? <img src={p.img} alt="" style="width:40px;height:32px;object-fit:contain;background:#fff;border:1px solid var(--line)" /> : ''}</td>
            <td><strong style="font-weight:600">{p.name}</strong></td>
            <td class="muted">{p.cat}</td>
            <td><span class="pill" style="background:#eee;color:#444">{p.type}</span></td>
            <td style="text-align:right">{p.priceMax ? `${formatINR(p.price)} – ${formatINR(p.priceMax)}` : formatINR(p.price)}</td>
            <td style="text-align:center" class="muted">{p.variants || '—'}</td>
            <td style="text-align:right;white-space:nowrap">
              <button type="button" class="ico-btn qv" title="Quick view" aria-label="Quick view"
                data-p={JSON.stringify({slug:p.slug,name:p.name,img:p.img,cat:p.cat,type:p.type,price:p.price,priceMax:p.priceMax,variants:p.variants,featured:p.featured})}>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M8 4v5" stroke-linecap="round"/></svg>
              </button>
              <button type="button" class="ico-btn qe" title="Quick edit" aria-label="Quick edit"
                data-p={JSON.stringify({slug:p.slug,name:p.name,type:p.type,basePrice:p.basePrice,salePrice:p.salePrice,featured:p.featured})}>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 21v-4l11-11 4 4L8 21z"/><path d="M14 6l4 4"/></svg>
              </button>
              <a href={`/apaulogy-admin/products/${p.slug}/`} class="ico-btn" title="Full edit" aria-label="Full edit"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg></a>
              <a href={`/product/${p.slug}/`} target="_blank" class="ico-btn" title="View in store" aria-label="View"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg></a>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="muted" style="font-size:.78rem;margin-top:.8rem">Catalogue is read from the site data. Price / stock / feature overrides save to the database once D1 is connected.</p>
  <script>
    const q = document.getElementById('q');
    const rows = Array.from(document.querySelectorAll('#tbl tbody tr'));
    const count = document.getElementById('count');
    q.addEventListener('input', () => {
      const v = q.value.trim().toLowerCase();
      let n = 0;
      rows.forEach((r) => {
        const hit = !v || r.dataset.name.includes(v) || r.dataset.cat.includes(v);
        r.style.display = hit ? '' : 'none'; if (hit) n++;
      });
      count.textContent = `${n} products`;
    });
  </script>

  <!-- Quick view modal -->
  <div id="qv-modal" class="pm-root" hidden><div class="pm-back" data-pm-close></div>
    <div class="pm-card">
      <button class="pm-x" data-pm-close aria-label="Close">✕</button>
      <div id="qv-body"></div>
    </div>
  </div>

  <!-- Quick edit modal -->
  <div id="qe-modal" class="pm-root" hidden><div class="pm-back" data-pm-close></div>
    <div class="pm-card">
      <button class="pm-x" data-pm-close aria-label="Close">✕</button>
      <h3 id="qe-title" style="font-size:1.2rem;font-weight:700;margin:0 0 1rem"></h3>
      <div id="qe-simple" style="display:grid;gap:.8rem">
        <label class="fld">Price (₹)<input id="qe-price" type="number" /></label>
        <label class="fld">Sale price (₹, optional)<input id="qe-sale" type="number" placeholder="—" /></label>
      </div>
      <p id="qe-var-note" class="muted" style="font-size:.8rem" hidden>This is a variable product — edit individual variation prices in Full edit.</p>
      <label style="display:flex;gap:.5rem;align-items:center;margin-top:.8rem"><input type="checkbox" id="qe-featured" /> Featured on homepage</label>
      <div style="display:flex;gap:.6rem;justify-content:flex-end;margin-top:1.3rem">
        <a id="qe-full" class="btn" href="#">Full edit ↗</a>
        <button class="btn" id="qe-save" style="background:var(--gold);color:#0a0f16;font-weight:600">Save</button>
      </div>
      <p class="muted" id="qe-msg" style="font-size:.75rem;text-align:right;margin-top:.5rem"></p>
    </div>
  </div>

<style is:global>
  .ico-btn{ display:inline-grid; place-items:center; width:30px; height:30px; border:1px solid var(--line); border-radius:7px; color:var(--ink-soft); margin-left:.35rem; transition:all .12s; }
  .ico-btn:hover{ border-color:var(--gold); color:var(--gold); }
  .pm-root{ position:fixed; inset:0; z-index:80; display:grid; place-items:center; padding:1.2rem; }
  .pm-back{ position:absolute; inset:0; background:rgba(0,0,0,.55); backdrop-filter:blur(3px); }
  .pm-card{ position:relative; width:460px; max-width:100%; background:var(--panel); border:1px solid var(--line-strong); border-radius:12px; padding:1.6rem; box-shadow:0 24px 70px rgba(0,0,0,.5); color:var(--ink); }
  .pm-x{ position:absolute; top:.9rem; right:1rem; background:none; border:0; color:var(--muted); cursor:pointer; font-size:1rem; }
  .pm-x:hover{ color:var(--ink); }
  .qv-hero{ width:100%; height:220px; object-fit:contain; background:#fff; border-radius:8px; border:1px solid var(--line); }
  .qv-name{ font-size:1.3rem; font-weight:700; margin:.9rem 0 .2rem; }
  .qv-meta{ display:flex; gap:.5rem; flex-wrap:wrap; margin:.6rem 0; }
  .qv-tag{ font-size:.7rem; padding:.2rem .55rem; border-radius:20px; background:var(--raise); color:var(--ink-soft); }
  .fld{ display:block; } .fld input{ width:100%; margin-top:.3rem; }
</style>

  <script>
    (function(){
      function openM(id){ document.getElementById(id).hidden=false; }
      function closeAll(){ document.querySelectorAll('.pm-root').forEach(m=>m.hidden=true); }
      document.querySelectorAll('[data-pm-close]').forEach(el=>el.addEventListener('click',closeAll));
      document.addEventListener('keydown',e=>{ if(e.key==='Escape') closeAll(); });
      var inr=function(p){ return '₹'+Math.round(p/100).toLocaleString('en-IN'); };

      document.querySelectorAll('.qv').forEach(function(b){ b.addEventListener('click',function(){
        var p=JSON.parse(b.dataset.p);
        document.getElementById('qv-body').innerHTML =
          (p.img?'<img class="qv-hero" src="'+p.img+'" alt=""/>':'') +
          '<div class="qv-name">'+p.name+'</div>'+
          '<div class="qv-meta"><span class="qv-tag">'+p.cat+'</span><span class="qv-tag">'+p.type+(p.variants?(' · '+p.variants+' variants'):'')+'</span>'+(p.featured?'<span class="qv-tag">★ Featured</span>':'')+'</div>'+
          '<div style="font-size:1.1rem;font-weight:700;margin:.4rem 0 1rem">'+(p.priceMax?(inr(p.price)+' – '+inr(p.priceMax)):inr(p.price))+'</div>'+
          '<div style="display:flex;gap:.6rem"><a class="btn" href="/apaulogy-admin/products/'+p.slug+'/">Edit</a><a class="btn" target="_blank" href="/product/'+p.slug+'/">View in store ↗</a></div>';
        openM('qv-modal');
      }); });

      var cur=null;
      document.querySelectorAll('.qe').forEach(function(b){ b.addEventListener('click',function(){
        cur=JSON.parse(b.dataset.p);
        document.getElementById('qe-title').textContent='Quick edit — '+cur.name;
        document.getElementById('qe-full').href='/apaulogy-admin/products/'+cur.slug+'/';
        var isVar=cur.type==='variable';
        document.getElementById('qe-simple').style.display=isVar?'none':'grid';
        document.getElementById('qe-var-note').hidden=!isVar;
        if(!isVar){ document.getElementById('qe-price').value=(cur.basePrice/100); document.getElementById('qe-sale').value=cur.salePrice?(cur.salePrice/100):''; }
        document.getElementById('qe-featured').checked=!!cur.featured;
        document.getElementById('qe-msg').textContent='';
        openM('qe-modal');
      }); });

      document.getElementById('qe-save').addEventListener('click',async function(){
        if(!cur) return; var msg=document.getElementById('qe-msg'); msg.textContent='Saving…';
        var body={ slug:cur.slug, featured:document.getElementById('qe-featured').checked?1:0 };
        if(cur.type!=='variable'){
          var pr=document.getElementById('qe-price').value, sl=document.getElementById('qe-sale').value;
          body.price=pr?Math.round(Number(pr)*100):null;
          body.sale_price=sl?Math.round(Number(sl)*100):null;
        }
        var r=await fetch('/api/admin/product',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});
        msg.textContent=r.ok?'Saved ✓':'Failed — database connected?';
        if(r.ok) setTimeout(function(){ location.reload(); },700);
      });
    })();
  </script>

</AdminLayout>
