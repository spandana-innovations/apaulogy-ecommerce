---
export const prerender = false;
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getStats, listOrders, orderYears } from '../../lib/admin-data';
import { formatINR } from '../../lib/format';
const env = (Astro.locals as any)?.runtime?.env ?? {};
const stats = await getStats(env);
const url = Astro.url;
const status = url.searchParams.get('status') || 'all';
const year = url.searchParams.get('year') || 'all';
const search = url.searchParams.get('q') || '';
const archived = url.searchParams.get('tab') === 'archived';
const page = parseInt(url.searchParams.get('page') || '1', 10);
const per = Math.min(50, Math.max(10, parseInt(url.searchParams.get('per') || '10', 10)));
const { rows, total, pages } = await listOrders(env, { status, year, search, page, per, archived });
const years = await orderYears(env);
const STATUSES = ['all','pending','processing','on-hold','completed','shipped','cancelled','refunded','failed'];
function qs(over: Record<string,string>) {
  const p = new URLSearchParams({ tab: archived?'archived':'', status, year, q: search, page: String(page), per: String(per), ...over });
  for (const [k,v] of [...p.entries()]) if (!v || v==='all' || (k==='page'&&v==='1') || (k==='per'&&v==='10')) p.delete(k);
  const s = p.toString(); return s ? `?${s}` : '';
}
---
<AdminLayout title="Orders" active="orders" dbBound={stats.dbBound}>
  <div class="ord-tabs">
    <a href="/apaulogy-admin/orders/" class={!archived ? 'ord-tab on' : 'ord-tab'}>Live <span class="muted">· last 3 months</span></a>
    <a href="/apaulogy-admin/orders/?tab=archived" class={archived ? 'ord-tab on' : 'ord-tab'}>Archived <span class="muted">· older</span></a>
  </div>

  <form method="get" class="filters">
    {archived && <input type="hidden" name="tab" value="archived" />}
    <input name="q" value={search} placeholder="Search order #, email, phone…" class="f-search"/>
    <select name="status" onchange="this.form.submit()">
      {STATUSES.map((s)=>(<option value={s} selected={s===status}>{s==='all'?'All statuses':s}</option>))}
    </select>
    <select name="year" onchange="this.form.submit()">
      <option value="all" selected={year==='all'}>All years</option>
      {years.map((y:string)=>(<option value={y} selected={y===year}>{y}</option>))}
    </select>
    <select name="per" onchange="this.form.submit()" title="Rows per page">
      {[10,20,50].map((n)=>(<option value={n} selected={n===per}>{n} / page</option>))}
    </select>
    <button class="btn" type="submit">Filter</button>
    <span class="muted count">{total.toLocaleString()} orders</span>
  </form>

  <div id="bulk-bar" class="bulk-bar" hidden>
    <span id="bulk-count" class="bulk-count">0 selected</span>
    <select id="bulk-status" class="bulk-input">
      <option value="">Set status…</option>
      <option value="processing">Processing</option><option value="on-hold">On hold</option>
      <option value="shipped">Shipped</option><option value="completed">Completed</option>
      <option value="cancelled">Cancelled</option><option value="refunded">Refunded</option>
    </select>
    <button class="btn" id="bulk-apply" style="background:var(--gold);color:#0a0f16;font-weight:600">Apply</button>
    <button class="btn" id="bulk-archive">Archive</button>
    <button class="btn" id="bulk-clear">Clear</button>
    <span class="muted" id="bulk-msg" style="font-size:.78rem"></span>
  </div>
  <div class="card" style="overflow:hidden">
    {rows.length ? (
      <table>
        <thead><tr><th style="width:32px"><input type="checkbox" id="sel-all" aria-label="Select all"/></th><th>Order</th><th>Customer</th><th>Payment</th><th>Status</th><th>Tracking</th><th style="text-align:right">Total</th><th>Date</th></tr></thead>
        <tbody>
          {rows.map((o: any) => (
            <tr>
              <td><input type="checkbox" class="row-sel" value={o.order_number} aria-label={`Select ${o.order_number}`}/></td>
              <td><a href={`/apaulogy-admin/orders/${o.order_number}/`} class="u"><strong>{o.order_number}</strong></a></td>
              <td>{o.email}<br/><span class="muted" style="font-size:.72rem">{o.phone||''}</span></td>
              <td class="muted">{/bank/i.test(o.notes||'') ? 'Bank transfer' : (o.notes||'Online')}</td>
              <td><span class={`pill s-${o.status}`}>{o.status}</span></td>
              <td class="muted" style="font-size:.78rem">{o.tracking_number||'—'}</td>
              <td style="text-align:right">{formatINR(o.total)}</td>
              <td class="muted">{(o.created_at||'').slice(0,10)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    ) : (<div class="empty">No orders match these filters.</div>)}
  </div>

  {pages > 1 && (
    <nav class="pager">
      {page > 1 && <a class="btn" href={qs({ page: String(page-1) })}>← Prev</a>}
      <span class="muted">Page {page} of {pages}</span>
      {page < pages && <a class="btn" href={qs({ page: String(page+1) })}>Next →</a>}
    </nav>
  )}

  <style is:global>
    .filters{ display:flex; gap:.6rem; align-items:center; margin-bottom:1rem; flex-wrap:wrap }
    .filters .f-search{ flex:1; min-width:220px } .filters select,.filters input{ padding:.5rem .6rem; border:1px solid var(--line-strong); font:inherit; background:var(--panel-2); color:var(--ink) }
    .filters .count{ font-family:var(--font-sans); font-size:.82rem; margin-left:auto }
    .pager{ display:flex; gap:1rem; align-items:center; justify-content:center; margin-top:1.4rem; font-family:var(--font-sans); font-size:.82rem }
  </style>
</AdminLayout>
<style is:global>
  .ord-tabs{ display:flex; gap:.5rem; margin-bottom:1.1rem; border-bottom:1px solid var(--line); }
  .ord-tab{ padding:.55rem .9rem; font-family:var(--font-sans); font-size:.85rem; font-weight:500; color:var(--muted); border-bottom:2px solid transparent; margin-bottom:-1px; }
  .ord-tab.on{ color:var(--ink); border-bottom-color:var(--gold); }
  .ord-tab:hover{ color:var(--ink); }
</style>

<style is:global>
  .bulk-bar{ display:flex; align-items:center; gap:.7rem; margin-bottom:1rem; padding:.7rem 1rem;
    background:var(--gold-soft); border:1px solid var(--gold); border-radius:8px; flex-wrap:wrap; }
  .bulk-count{ font-family:var(--font-sans); font-weight:600; font-size:.85rem; }
  .bulk-input{ padding:.45rem .6rem; }
  .row-sel, #sel-all{ width:16px; height:16px; cursor:pointer; accent-color:var(--gold); }
</style>
<script is:inline>
  (function(){
    function init(){
      var all=document.getElementById('sel-all');
      var bar=document.getElementById('bulk-bar');
      var count=document.getElementById('bulk-count');
      var msg=document.getElementById('bulk-msg');
      if(!bar) return;
      function selected(){ return Array.prototype.slice.call(document.querySelectorAll('.row-sel:checked')).map(function(c){return c.value;}); }
      function refresh(){ var n=selected().length; count.textContent=n+' selected'; bar.hidden=(n===0); if(all){ var total=document.querySelectorAll('.row-sel').length; all.checked=(n>0&&n===total); all.indeterminate=(n>0&&n<total);} }
      document.querySelectorAll('.row-sel').forEach(function(c){ c.addEventListener('change',refresh); });
      if(all){ all.addEventListener('change',function(){ document.querySelectorAll('.row-sel').forEach(function(c){ c.checked=all.checked; }); refresh(); }); }
      document.getElementById('bulk-clear')?.addEventListener('click',function(){ document.querySelectorAll('.row-sel').forEach(function(c){c.checked=false;}); if(all)all.checked=false; refresh(); });
      async function bulk(body){ var orders=selected(); if(!orders.length) return; msg.textContent='Applying to '+orders.length+'…';
        var r=await fetch('/api/admin/orders-bulk',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(Object.assign({orders:orders},body))});
        var d=await r.json().catch(function(){return{};});
        if(d.ok){ msg.textContent='✓ '+d.done+' updated'+(d.failed?(' · '+d.failed+' failed'):''); setTimeout(function(){location.reload();},700); }
        else { msg.style.color='#c23b3b'; msg.textContent='✗ '+(d.error||'Failed'); }
      }
      document.getElementById('bulk-apply')?.addEventListener('click',function(){ var st=document.getElementById('bulk-status').value; if(!st){ msg.textContent='Choose a status first.'; return; } bulk({action:'status',status:st}); });
      document.getElementById('bulk-archive')?.addEventListener('click',function(){ if(confirm('Archive '+selected().length+' order(s)?')) bulk({action:'archive'}); });
      refresh();
    }
    if(document.readyState!=='loading') init(); else document.addEventListener('DOMContentLoaded',init);
    document.addEventListener('astro:page-load',init);
  })();
</script>
