---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { SOCIALS } from '../lib/socials';
---
<BaseLayout title="Contact" description="Visit or write to the aPaulogy gallery in Bengaluru — orders, commissions, bulk gifting and gallery visits.">
  <!-- Header band -->
  <section class="text-center container-page pt-16 pb-10">
    <p class="eyebrow">Say hello</p>
    <h1 class="text-5xl sm:text-6xl mt-3">Come visit, or write to us</h1>
    <p class="mt-4 text-[var(--color-ink-soft)] max-w-2xl mx-auto">
      For orders, commissions, bulk gifting, or simply to wander the gallery — we'd love to hear from you.
    </p>
  </section>

  <div class="container-page pb-20">
    <!-- Contact cards -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-12">
      <div class="c-card">
        <span class="c-ico"><Icon name="pin" size={22} stroke={1.4} /></span>
        <h3 class="c-h">Visit</h3>
        <p class="c-p">002 Edward House, 37 Pottery Road, Richards Town, Bengaluru 560 005</p>
      </div>
      <div class="c-card">
        <span class="c-ico"><Icon name="mail" size={22} stroke={1.4} /></span>
        <h3 class="c-h">Email</h3>
        <p class="c-p"><a href="mailto:info@apaulogy.com" class="link-underline">info@apaulogy.com</a></p>
      </div>
      <div class="c-card">
        <span class="c-ico"><Icon name="shield" size={22} stroke={1.4} /></span>
        <h3 class="c-h">Gallery hours</h3>
        <p class="c-p">Mon – Sat · 10:00 am – 6:30 pm<br />Sunday closed</p>
      </div>
      <div class="c-card">
        <span class="c-ico"><Icon name="instagram" size={22} stroke={1.4} /></span>
        <h3 class="c-h">Follow</h3>
        <p class="c-p flex gap-3">{SOCIALS.map((sm) => (<a href={sm.href} rel="noopener" target="_blank" class="link-underline">{sm.name}</a>))}</p>
      </div>
    </div>

    <!-- Map + form -->
    <div class="grid lg:grid-cols-[1.15fr_1fr] gap-10 items-stretch">
      <div class="c-map">
        <iframe
          title="aPaulogy Gallery on Google Maps"
          src="https://www.google.com/maps?q=aPaulogy+Gallery+Pottery+Road+Richards+Town+Bengaluru+560005&output=embed"
          width="100%" height="100%" style="border:0;min-height:420px" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
        <a class="map-link" href="https://www.google.com/maps/search/?api=1&query=aPaulogy+Gallery+Pottery+Road+Richards+Town+Bengaluru+560005" rel="noopener" target="_blank">Open in Google Maps →</a>
      </div>

      <form class="c-form" data-contact>
        <h2 class="text-3xl mb-1">Send a message</h2>
        <p class="text-sm text-[var(--color-muted)] mb-5" style="font-family:var(--font-sans)">We usually reply within a day or two.</p>
        <div class="space-y-4">
          <label class="block"><span class="field-label">Name</span><input name="name" required class="input" /></label>
          <label class="block"><span class="field-label">Email</span><input name="email" type="email" required class="input" /></label>
          <label class="block"><span class="field-label">Phone (optional)</span><input name="phone" class="input" inputmode="tel" /></label>
          <label class="block"><span class="field-label">Message</span><textarea name="message" rows="5" required class="input"></textarea></label>
          <button class="btn btn-primary w-full gap-2" type="submit"><Icon name="mail" size={16} /> Send message</button>
          <p data-contact-msg class="text-sm text-center" style="font-family:var(--font-sans)" hidden></p>
        </div>
      </form>
    </div>
  </div>

  <style>
    .c-card{ border:1px solid var(--color-line); padding:1.4rem; transition:border-color .15s, transform .15s; }
    .c-card:hover{ border-color:var(--color-ink); transform:translateY(-2px); }
    .c-ico{ display:inline-grid; place-items:center; width:44px; height:44px; border:1px solid var(--color-ink); margin-bottom:.9rem; }
    .c-h{ font-family:var(--font-display); font-size:1.35rem; margin-bottom:.35rem; }
    .c-p{ font-family:var(--font-sans); font-size:.86rem; color:var(--color-ink-soft); line-height:1.55; }
    .c-map{ border:1px solid var(--color-line-strong); display:flex; flex-direction:column; }
    .c-map iframe{ flex:1; filter:grayscale(.25) contrast(1.05); }
    .c-form{ border:1px solid var(--color-line-strong); padding:2rem 1.8rem; background:#fff; }
    @media (max-width:1023px){ .c-map iframe{ min-height:320px; } }
  </style>

  <script>
    function initContact(){
      const form=document.querySelector('[data-contact]') as HTMLFormElement|null;
      if(!form||form.dataset.bound) return; form.dataset.bound='1';
      const msg=document.querySelector('[data-contact-msg]') as HTMLElement;
      form.addEventListener('submit', async(e)=>{
        e.preventDefault();
        const btn=form.querySelector('button') as HTMLButtonElement; btn.disabled=true;
        const body=Object.fromEntries(new FormData(form).entries());
        try{
          await fetch('/api/contact',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)}).catch(()=>{});
          msg.hidden=false; msg.style.color='#1f6b2e'; msg.textContent='Thank you — your message has been sent. We\u2019ll be in touch soon.';
          form.reset();
        }catch{ msg.hidden=false; msg.style.color='#b00020'; msg.textContent='Something went wrong. Please email info@apaulogy.com.'; }
        btn.disabled=false;
      });
    }
    initContact();
    document.addEventListener('astro:after-swap', initContact);
  </script>
</BaseLayout>
