---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---
<BaseLayout title="Account" description="Your aPaulogy account — sign in or create an account to see your orders." noindex={true}>
  <div class="container-page py-16 min-h-[60vh] max-w-md mx-auto" style="font-family:var(--font-sans)">

    <!-- Signed OUT: sign in / create account -->
    <div id="acc-auth">
      <div class="flex justify-center mb-4 opacity-70"><Icon name="user" size={44} stroke={1.2} /></div>
      <h1 class="text-4xl text-center" style="font-family:var(--font-display)">Your account</h1>
      <p class="text-center text-[var(--color-ink-soft)] mt-3 text-sm">Sign in to see your orders, or create an account. You can also just <a href="/store/" class="link-underline">keep shopping</a> and check out as a guest.</p>

      <!-- tabs -->
      <div class="acc-tabs" role="tablist">
        <button id="tab-signin" class="acc-tab is-on" role="tab">Sign in</button>
        <button id="tab-register" class="acc-tab" role="tab">Create account</button>
      </div>

      <!-- Sign in -->
      <form id="form-signin" class="mt-6 space-y-4">
        <label class="block"><span class="field-label">Email</span><input name="email" type="email" required class="input" autocomplete="email" /></label>
        <label class="block"><span class="field-label">Password</span><input name="password" type="password" required class="input" autocomplete="current-password" /></label>
        <button class="btn btn-primary w-full gap-2" type="submit"><Icon name="user" size={16} /> Sign in</button>
        <p class="text-center text-sm"><a href="/account/reset/" class="link-underline text-[var(--color-muted)]">Forgot password?</a></p>
        <p class="acc-msg" data-msg hidden></p>
      </form>

      <!-- Create account -->
      <form id="form-register" class="mt-6 space-y-4 hidden">
        <label class="block"><span class="field-label">Name</span><input name="name" required class="input" autocomplete="name" /></label>
        <label class="block"><span class="field-label">Email</span><input name="email" type="email" required class="input" autocomplete="email" /></label>
        <label class="block"><span class="field-label">Password</span><input name="password" type="password" required minlength="8" class="input" autocomplete="new-password" /><small class="text-xs text-[var(--color-muted)]">At least 8 characters.</small></label>
        <button class="btn btn-primary w-full gap-2" type="submit"><Icon name="user" size={16} /> Create account</button>
        <p class="acc-msg" data-msg hidden></p>
      </form>
    </div>

    <!-- Signed IN -->
    <div id="acc-in" class="hidden">
      <div class="flex justify-center mb-4"><span class="w-14 h-14 grid place-items-center border-2 border-black rounded-full"><Icon name="user" size={26} /></span></div>
      <h1 class="text-4xl text-center" style="font-family:var(--font-display)">Hello, <span id="acc-name"></span></h1>
      <p id="acc-email" class="text-center text-[var(--color-muted)] mt-2 text-sm"></p>

      <h2 class="text-lg mt-10 mb-3" style="font-family:var(--font-display)">Your orders</h2>
      <div id="acc-orders" class="space-y-3"></div>
      <p id="acc-noorders" class="text-sm text-[var(--color-ink-soft)] hidden">No orders yet. <a href="/store/" class="link-underline">Start shopping</a>.</p>

      <button id="acc-signout" class="btn btn-outline w-full mt-10">Sign out</button>
    </div>
  </div>

  <style>
    .acc-tabs{ display:flex; margin-top:2.25rem; margin-bottom:.5rem; border:1px solid var(--color-ink) !important;
      border-radius:2px; overflow:hidden; }
    .acc-tab{ flex:1; padding:.72rem 1.5rem; font-family:var(--font-sans); font-size:.78rem; font-weight:600;
      text-transform:uppercase; letter-spacing:.14em; background-color:#fff !important; color:var(--color-muted) !important;
      border:0; cursor:pointer; transition:background-color .15s ease, color .15s ease; }
    .acc-tab + .acc-tab{ border-left:1px solid var(--color-ink) !important; }
    .acc-tab:hover{ color:var(--color-ink) !important; }
    .acc-tab.is-on{ background-color:var(--color-ink) !important; color:#fff !important; }
    .acc-msg{ font-size:.82rem; text-align:center; }
    .ord{ border:1px solid var(--color-line-strong); padding:.9rem 1rem; display:flex; justify-content:space-between; align-items:center; gap:1rem; }
    .ord .ref{ font-weight:600; }
    .ord .meta{ font-size:.78rem; color:var(--color-muted); }
    .ord .st{ font-size:.68rem; text-transform:uppercase; letter-spacing:.06em; border:1px solid var(--color-line-strong); padding:.15rem .5rem; white-space:nowrap; }
  </style>

  <script>
    function inr(p:number){ return new Intl.NumberFormat('en-IN',{style:'currency',currency:'INR',maximumFractionDigits:0}).format((p||0)/100); }
    function fmtDate(s:string){ try{ return new Date(s.includes('T')?s:s.replace(' ','T')+'Z').toLocaleDateString('en-IN',{day:'numeric',month:'short',year:'numeric'}); }catch{ return s||''; } }
    const $ = (id:string)=>document.getElementById(id)!;

    function showMsg(form:HTMLElement, text:string, ok=false){
      const m=form.querySelector('[data-msg]') as HTMLElement; if(!m) return;
      m.hidden=false; m.style.color = ok ? '#1f6b2e' : '#b00020'; m.textContent=text;
    }

    async function loadMe(){
      let d:any={authed:false};
      try{ d = await (await fetch('/api/account/me',{headers:{'accept':'application/json'}})).json(); }catch{}
      if(d.authed){
        $('acc-auth').classList.add('hidden');
        $('acc-in').classList.remove('hidden');
        $('acc-name').textContent = d.name || 'friend';
        $('acc-email').textContent = d.email || '';
        try{ localStorage.setItem('apaulogy_user', JSON.stringify({ name:d.name, email:d.email })); }catch{}
        const wrap=$('acc-orders'); wrap.innerHTML='';
        if(d.orders && d.orders.length){
          for(const o of d.orders){
            const el=document.createElement('div'); el.className='ord';
            el.innerHTML='<div><div class="ref">'+o.ref+'</div><div class="meta">'+fmtDate(o.date)+' · '+inr(o.total)+'</div></div>'+
              '<span class="st">'+String(o.status||'').replace(/^\w/,(c:string)=>c.toUpperCase())+'</span>';
            wrap.appendChild(el);
          }
          $('acc-noorders').classList.add('hidden');
        } else { $('acc-noorders').classList.remove('hidden'); }
      } else {
        $('acc-in').classList.add('hidden');
        $('acc-auth').classList.remove('hidden');
      }
    }

    function initAccount(){
      const root=$('acc-auth'); if(!root || (root as any).dataset.bound) return; (root as any).dataset.bound='1';

      const tS=$('tab-signin'), tR=$('tab-register'), fS=$('form-signin'), fR=$('form-register');
      tS.addEventListener('click',()=>{ tS.classList.add('is-on'); tR.classList.remove('is-on'); fS.classList.remove('hidden'); fR.classList.add('hidden'); });
      tR.addEventListener('click',()=>{ tR.classList.add('is-on'); tS.classList.remove('is-on'); fR.classList.remove('hidden'); fS.classList.add('hidden'); });

      async function submit(form:HTMLFormElement, url:string){
        const btn=form.querySelector('button[type=submit]') as HTMLButtonElement; btn.disabled=true;
        const body=Object.fromEntries(new FormData(form).entries());
        try{
          const r=await fetch(url,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});
          const d=await r.json();
          if(d.ok){ await loadMe(); } else { showMsg(form, d.error || 'Something went wrong.'); }
        }catch{ showMsg(form,'Could not reach the server. Please try again.'); }
        btn.disabled=false;
      }
      (fS as HTMLFormElement).addEventListener('submit',(e)=>{ e.preventDefault(); submit(fS as HTMLFormElement,'/api/account/login'); });
      (fR as HTMLFormElement).addEventListener('submit',(e)=>{ e.preventDefault(); submit(fR as HTMLFormElement,'/api/account/register'); });

      $('acc-signout').addEventListener('click', async ()=>{
        try{ await fetch('/api/account/logout',{method:'POST'}); }catch{}
        try{ localStorage.removeItem('apaulogy_user'); }catch{}
        loadMe();
      });

      loadMe();
    }
    initAccount();
    document.addEventListener('astro:after-swap', initAccount);
  </script>
</BaseLayout>
