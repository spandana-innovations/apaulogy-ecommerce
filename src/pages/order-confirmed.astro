---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---
<BaseLayout title="Order Confirmed" description="Thank you for your order." noindex={true}>
  <div class="container-page py-16 min-h-[60vh] max-w-2xl mx-auto">
    <div class="text-center">
      <div class="flex justify-center mb-4"><span class="w-16 h-16 grid place-items-center border-2 border-black rounded-full"><Icon name="check" size={32} /></span></div>
      <h1 class="text-5xl mt-2">Thank you</h1>
      <p class="mt-4 text-lg text-[var(--color-ink-soft)]">
        Your order <span id="order-ref" class="font-medium"></span> has been received.
        A confirmation is on its way to your inbox.
      </p>
    </div>

    <!-- Order details -->
    <div id="order-block" class="mt-8 border border-[var(--color-line)] p-6 hidden" style="font-family:var(--font-sans)">
      <h2 class="text-lg mb-3" style="font-family:var(--font-display)">Order details</h2>
      <ul id="order-items" class="text-sm space-y-2"></ul>
      <div id="order-totals" class="text-sm mt-4 pt-4 border-t border-[var(--color-line)] space-y-1"></div>
    </div>

    <div class="mt-10 flex justify-center gap-3">
      <a href="/store/" class="btn btn-primary gap-2"><Icon name="store" size={16} /> Continue shopping</a>
      <a href="/" class="btn btn-outline">Back home</a>
    </div>
  </div>

  <script>
    function inr(p:number){ return new Intl.NumberFormat('en-IN',{style:'currency',currency:'INR',maximumFractionDigits:0}).format(p/100); }
    const params = new URLSearchParams(location.search);
        const ref = params.get('ref') || params.get('order') || '';
    if (ref) document.getElementById('order-ref')!.textContent = `#${ref}`;

    let order:any = null;
    try { order = JSON.parse(localStorage.getItem('apaulogy_last_order') || 'null'); } catch {}

    if (order && Array.isArray(order.items)) {
      const ob = document.getElementById('order-block')!; ob.classList.remove('hidden');
      document.getElementById('order-items')!.innerHTML = order.items.map((it:any)=>`<li class="flex justify-between gap-3"><span>${it.name}${it.variant?` <span class="text-[var(--color-muted)]">(${it.variant})</span>`:''} × ${it.qty}</span><span>${inr(it.price*it.qty)}</span></li>`).join('');
      document.getElementById('order-totals')!.innerHTML =
        `<div class="flex justify-between"><span class="text-[var(--color-muted)]">Subtotal</span><span>${inr(order.subtotal)}</span></div>`+
        `<div class="flex justify-between"><span class="text-[var(--color-muted)]">Shipping</span><span>${order.shipping===0?'Free':inr(order.shipping)}</span></div>`+
        `<div class="flex justify-between font-medium text-base pt-1"><span>Total</span><span>${inr(order.total)}</span></div>`;
    }
  </script>
</BaseLayout>
