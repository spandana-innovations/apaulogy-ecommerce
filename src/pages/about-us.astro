---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { SOCIALS } from '../lib/socials';
import { breadcrumbSchema, SITE_NAME } from '../lib/seo';

const jsonld = [
  breadcrumbSchema([{ name: 'Home', url: '/' }, { name: 'About', url: '/about-us/' }], Astro.site),
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Paul Fernandes',
    jobTitle: 'Cartoonist, Illustrator & Founder',
    worksFor: { '@type': 'Organization', name: SITE_NAME },
    description: 'Bengaluru-based cartoonist and watercolourist chronicling the life and times of 1970s Bangalore.',
    image: new URL('/brand/paul-with-book.webp', Astro.site ?? Astro.url.origin).toString(),
  },
];
---

<BaseLayout
  title="About"
  description="aPaulogy is the gallery of cartoonist Paul Fernandes — sixty watercolours reminiscing the gentle, laid-back Bangalore of the 1970s, with detours through vintage Mumbai and Goa."
  image="/brand/paul-with-book.webp"
  imageAlt="Paul Fernandes with his book, Bangalore: Swinging in the 70s"
  type="article"
  jsonld={jsonld}
>
  <div class="container-page py-12 lg:py-16">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/" class="link-hover">Home</a> <span aria-hidden="true" class="opacity-50">/</span>
      <span class="text-[var(--color-ink-soft)]">About</span>
    </nav>

    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <!-- Text -->
      <div class="max-w-xl">
        <p class="eyebrow">aPaulogy</p>
        <h1 class="text-5xl sm:text-6xl mt-3">An ‘ology on the life &amp; times of Bangalore</h1>

        <div class="prose-paper mt-8 text-[var(--color-ink-soft)] space-y-5">
          <p>
            aPaulogy is a curious name — both weighty and light, serious and funny, insightful and
            ludicrous. Perfect for cartoonist Paul Fernandes’ gallery, which showcases sixty
            watercolour prints inspired by his ‘ology on the life and times of Bangalore in the 70s.
          </p>
          <p>
            Entering aPaulogy is like walking down memory lane — a gentle, laid-back city where people
            walked everywhere and stopped to wish; a time when tongas were summoned for long journeys
            and riding a cycle minus a kerosene oil lamp was a serious crime.
          </p>
          <p>
            Recognise in each of Paul’s watercolours the well-known landmarks of old Bangalore — schools
            and colleges, churches and theatres, bars and restaurants, tree-lined shaded avenues and
            graceful monkey-topped bungalows — the pensioners and characters, all remembered with
            light-hearted humour.
          </p>
          <p>
            Paul began drawing this older, slower city after his ancestral home on Pottery Road was
            pulled down. What started as a personal, pictorial diary of streets and buildings, people
            and events, became an artist’s gift to his city — now carried onto prints, plaques, tiles
            and everyday things to keep the memory close.
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-3 mt-9">
          <a href="/store/" class="btn btn-primary gap-2"><Icon name="store" size={16} /> Explore the gallery</a>
          <a href="/contact-us/" class="btn btn-outline gap-2"><Icon name="mail" size={15} /> Visit or contact</a>
        </div>

        <div class="flex items-center gap-3 mt-7">
          {SOCIALS.map((s) => (
            <a href={s.href} rel="noopener" target="_blank" aria-label={`aPaulogy on ${s.name}`}
              class="w-10 h-10 grid place-items-center border border-[var(--color-ink)] hover:bg-black hover:text-white transition-colors">
              <Icon name={s.icon} size={18} stroke={1.5} />
            </a>
          ))}
        </div>
      </div>

      <!-- Paul + book -->
      <figure class="relative">
        <div class="relative bg-[var(--color-paper-deep)] border-0">
          <img src="/brand/paul-with-book.webp"
            alt="Paul Fernandes with his book, Bangalore: Swinging in the 70s"
            class="protected w-full h-auto object-contain" width="450" height="436" loading="eager" />
        </div>
        <figcaption class="mt-4 text-sm text-[var(--color-muted)] text-center" style="font-family:var(--font-sans)">
          Paul Fernandes, artist &amp; founder — with <em>Bangalore: Swinging in the 70s</em>.
        </figcaption>
      </figure>
    </div>

    <!-- A few landmarks he's known for -->
    <section class="mt-20 pt-12 border-t border-[var(--color-line)]">
      <p class="eyebrow text-center">Do you remember…?</p>
      <h2 class="text-3xl sm:text-4xl text-center mt-2">The places he draws</h2>
      <div class="flex flex-wrap justify-center gap-x-8 gap-y-2 mt-8 text-[var(--color-ink-soft)]" style="font-family:var(--font-serif)">
        {['Koshy’s','The Only Place','Airlines Hotel','MG Road','Victoria Hotel','Cubbon Park','Coffee House','Bangalore Club'].map((n, i) => (
          <>
            {i > 0 && <span class="text-[var(--color-muted)]" aria-hidden="true">·</span>}
            <span>{n}</span>
          </>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
