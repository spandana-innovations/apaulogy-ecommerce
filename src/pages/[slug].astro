---
import BaseLayout from '../layouts/BaseLayout.astro';
import pagesData from '../data/pages.json';
import { breadcrumbSchema, faqSchema } from '../lib/seo';

interface ContentPage { slug: string; title: string; html: string; }
const pages = pagesData as unknown as ContentPage[];

// contact-us has its own page (form); render the rest here.
const RENDER = pages.filter((p) => p.slug !== 'contact-us' && p.slug !== 'about-us');

export function getStaticPaths() {
  const all = pagesData as unknown as ContentPage[];
  return all.filter((p) => p.slug !== 'contact-us' && p.slug !== 'about-us').map((p) => ({ params: { slug: p.slug }, props: { page: p } }));
}

const { page } = Astro.props as { page: ContentPage };

// Plain-text summary of the page for a real meta description.
const plain = (page.html || '').replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
const metaDesc = plain ? plain.slice(0, 155).replace(/\s+\S*$/, '…') : `${page.title} — aPaulogy, the gallery of Paul Fernandes.`;

const jsonld: Record<string, unknown>[] = [
  breadcrumbSchema([{ name: 'Home', url: '/' }, { name: page.title, url: `/${page.slug}/` }], Astro.site),
];

// FAQPage rich result — parse Q/A pairs from the FAQ page markup.
if (page.slug === 'faq') {
  const qas: { q: string; a: string }[] = [];
  // questions are <h4>/<strong>/<p><strong> style; answers follow. Fallback: split on '?'.
  const text = page.html.replace(/<h[1-6][^>]*>/gi, '\n##').replace(/<\/h[1-6]>/gi, '\n')
    .replace(/<[^>]+>/g, '\n').replace(/&nbsp;/g, ' ');
  const lines = text.split('\n').map((l) => l.trim()).filter(Boolean);
  for (let i = 0; i < lines.length; i++) {
    if (lines[i].endsWith('?') && lines[i + 1] && !lines[i + 1].endsWith('?')) {
      qas.push({ q: lines[i].replace(/^##/, '').trim(), a: lines[i + 1].trim() });
    }
  }
  if (qas.length) jsonld.push(faqSchema(qas.slice(0, 20)));
}
---

<BaseLayout title={page.title} description={metaDesc} imageAlt={`${page.title} — aPaulogy`} type="article" jsonld={jsonld}>
  <div class="container-page py-16">
    <div class="max-w-3xl mx-auto">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/" class="link-hover">Home</a> <span aria-hidden="true">/</span> <span class="text-[var(--color-ink-soft)]">{page.title}</span>
      </nav>
      <header class="mb-10 text-center">
        <p class="eyebrow">aPaulogy</p>
        <h1 class="text-5xl sm:text-6xl mt-3">{page.title}</h1>
      </header>
      <article class="prose-paper" set:html={page.html} />
    </div>
  </div>
</BaseLayout>
