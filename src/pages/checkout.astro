---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---
<BaseLayout title="Checkout" description="Secure checkout for your aPaulogy order." noindex={true}>
  <div class="container-page py-12 min-h-[60vh]">
    <h1 class="text-5xl mb-8">Checkout</h1>

    <div id="co-empty" class="hidden text-center py-20">
      <div class="flex justify-center opacity-25 mb-4"><Icon name="cart" size={56} stroke={1} /></div>
      <p class="text-[var(--color-ink-soft)] text-lg">Your cart is empty.</p>
      <a href="/store/" class="btn btn-primary mt-6 gap-2"><Icon name="store" size={16} /> Browse the store</a>
    </div>

    <form id="co-form" class="hidden grid lg:grid-cols-[1.4fr_1fr] gap-10 items-start" novalidate>
      <div class="space-y-6">
        <fieldset class="border border-[var(--color-line-strong)] p-6">
          <legend class="text-2xl px-2 flex items-center gap-2"><Icon name="user" size={18} /> Contact</legend>
          <div class="grid sm:grid-cols-2 gap-4 mt-3">
            <label class="block sm:col-span-2"><span class="field-label">Full name</span><input name="name" required class="input" autocomplete="name" /><small class="err" data-err></small></label>
            <label class="block"><span class="field-label">Email</span><input name="email" type="email" required class="input" autocomplete="email" /><small class="err" data-err></small></label>
            <label class="block"><span class="field-label">Phone</span><input name="phone" required class="input" autocomplete="tel" inputmode="tel" /><small class="err" data-err></small></label>
          </div>
        </fieldset>

        <fieldset class="border border-[var(--color-line-strong)] p-6">
          <legend class="text-2xl px-2 flex items-center gap-2"><Icon name="truck" size={18} /> Shipping address</legend>
          <div class="grid sm:grid-cols-2 gap-4 mt-3">
            <label class="block sm:col-span-2"><span class="field-label">Address line 1</span><input name="line1" required class="input" autocomplete="address-line1" /><small class="err" data-err></small></label>
            <label class="block sm:col-span-2"><span class="field-label">Address line 2 (optional)</span><input name="line2" class="input" autocomplete="address-line2" /></label>
            <label class="block"><span class="field-label">PIN / ZIP code</span><input name="postcode" required class="input" autocomplete="postal-code" inputmode="numeric" maxlength="10" /><small class="err" data-err></small><small id="pin-hint" class="pin-hint"></small></label>
            <label class="block"><span class="field-label">City</span><input name="city" required class="input" autocomplete="address-level2" /><small class="err" data-err></small></label>
            <label class="block"><span class="field-label">State</span>
              <select name="state" required class="input" id="state-select" autocomplete="address-level1">
                <option value="" selected disabled>Select state</option>
                {['Andhra Pradesh','Arunachal Pradesh','Assam','Bihar','Chhattisgarh','Goa','Gujarat','Haryana','Himachal Pradesh','Jharkhand','Karnataka','Kerala','Madhya Pradesh','Maharashtra','Manipur','Meghalaya','Mizoram','Nagaland','Odisha','Punjab','Rajasthan','Sikkim','Tamil Nadu','Telangana','Tripura','Uttar Pradesh','Uttarakhand','West Bengal','Andaman & Nicobar Islands','Chandigarh','Dadra & Nagar Haveli and Daman & Diu','Delhi','Jammu & Kashmir','Ladakh','Lakshadweep','Puducherry'].map((st) => (<option value={st}>{st}</option>))}
                <option value="Other / Outside India">Other / Outside India</option>
              </select>
              <small class="err" data-err></small>
            </label>
            <label class="block"><span class="field-label">Country</span>
              <select name="country" required class="input" id="country-select" autocomplete="country-name">
                <option value="India" selected>India</option>
                {['United States','United Kingdom','United Arab Emirates','Canada','Australia','Singapore','Germany','France','Netherlands','New Zealand','Qatar','Saudi Arabia','Kuwait','Oman','Bahrain','Malaysia','Switzerland','Ireland','Sweden','Japan','Other'].map((c) => (<option value={c}>{c}</option>))}
              </select>
            </label>
          </div>
        </fieldset>

        <fieldset class="border border-[var(--color-line-strong)] p-6">
          <legend class="text-2xl px-2 flex items-center gap-2"><Icon name="shield" size={18} /> Payment</legend>
          <p class="mt-3 flex items-center gap-2.5 text-sm text-[var(--color-ink-soft)]" style="font-family:var(--font-sans)">
            <Icon name="shield" size={16} /> Secure online payment — UPI, cards, net-banking &amp; wallets via Razorpay. Instant confirmation.
          </p>
        </fieldset>
      </div>

      <aside class="border border-[var(--color-line-strong)] p-6 lg:sticky lg:top-24">
        <h2 class="text-2xl mb-4">Order summary</h2>
        <ul id="co-items" class="space-y-3 text-sm mb-4" style="font-family:var(--font-sans)"></ul>

        <!-- coupon -->
        <div class="flex gap-2 mb-4" style="font-family:var(--font-sans)">
          <input id="co-coupon" class="input !py-2 flex-1" placeholder="Coupon code" />
          <button type="button" id="co-apply" class="btn btn-outline !py-2 text-xs">Apply</button>
        </div>
        <p id="co-coupon-msg" class="text-xs mb-2" style="font-family:var(--font-sans)" hidden></p>

        <dl class="space-y-2 text-sm border-t border-[var(--color-line)] pt-4" style="font-family:var(--font-sans)">
          <div class="flex justify-between"><dt>Subtotal</dt><dd id="co-subtotal">—</dd></div>
          <div class="flex justify-between" id="co-discount-row" hidden><dt>Discount</dt><dd id="co-discount">—</dd></div>
          <div class="flex justify-between"><dt>Shipping</dt><dd id="co-shipping">—</dd></div>
        </dl>
        <!-- #1 GST invoice option, right by the totals -->
        <label class="flex items-start gap-2.5 mt-3 pt-3 border-t border-[var(--color-line)] cursor-pointer" style="font-family:var(--font-sans)">
          <input type="checkbox" id="co-gst" class="mt-0.5 accent-black" />
          <span class="text-sm">I need a <strong>GST invoice</strong></span>
        </label>
        <div id="co-gst-fields" class="mt-3 grid gap-2.5" hidden style="font-family:var(--font-sans)">
          <input id="co-gstin" class="input !py-2" placeholder="GSTIN (15 characters)" maxlength="15" style="text-transform:uppercase" />
          <input id="co-gst-name" class="input !py-2" placeholder="Registered business name" />
        </div>

        <div class="flex justify-between text-lg font-medium mt-3 pt-3 border-t border-[var(--color-line)]">
          <span>Total</span><span id="co-total">—</span>
        </div>
        <button type="submit" id="co-pay" class="btn btn-primary w-full mt-6 gap-2"><Icon name="shield" size={16} /> <span id="co-pay-label">Pay securely</span></button>
        <p id="co-error" class="text-sm mt-3 flex items-center gap-1.5" style="color:#b00020;font-family:var(--font-sans)" hidden></p>
        <p class="text-xs text-[var(--color-muted)] mt-4 text-center" style="font-family:var(--font-sans)">By placing your order you agree to our <a href="/terms-conditions/" class="link-underline">Terms</a> &amp; <a href="/privacy-policy/" class="link-underline">Privacy Policy</a>.</p>
      </aside>
    </form>
  </div>

  <style>
    .err { display:none; font-family:var(--font-sans); font-size:.72rem; color:#b00020; margin-top:.3rem; }
    .err.show { display:block; }
    .input.invalid { border-color:#b00020; box-shadow:0 0 0 1px #b00020; }
  </style>

  <script>
    const FREE_SHIPPING_OVER = 500000; // ₹5,000
    const SHIPPING_FLAT = 15000;       // ₹150
    function inr(p:number){ return new Intl.NumberFormat('en-IN',{style:'currency',currency:'INR',maximumFractionDigits:0}).format(p/100); }
    function loadRazorpay(){ return new Promise<boolean>((res)=>{ if((window as any).Razorpay) return res(true); const s=document.createElement('script'); s.src='https://checkout.razorpay.com/v1/checkout.js'; s.onload=()=>res(true); s.onerror=()=>res(false); document.body.appendChild(s); }); }

    function setErr(input:HTMLInputElement, msg:string){ input.classList.add('invalid'); const small=input.parentElement?.querySelector('[data-err]') as HTMLElement|null; if(small){ small.textContent=msg; small.classList.add('show'); } }
    function clearErr(input:HTMLInputElement){ input.classList.remove('invalid'); const small=input.parentElement?.querySelector('[data-err]') as HTMLElement|null; if(small){ small.textContent=''; small.classList.remove('show'); } }
    function validate(form:HTMLFormElement):boolean{
      let ok=true;
      for(const n of ['name','email','phone','line1','city','state','postcode','country']){
        const el=form.elements.namedItem(n) as HTMLInputElement; if(!el) continue; clearErr(el);
        if(!el.value.trim()){ setErr(el,'Required'); ok=false; }
      }
      const email=form.elements.namedItem('email') as HTMLInputElement;
      if(email.value && !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email.value)){ setErr(email,'Enter a valid email'); ok=false; }
      const phone=form.elements.namedItem('phone') as HTMLInputElement;
      if(phone.value && !/^[+]?[\d\s-]{7,15}$/.test(phone.value)){ setErr(phone,'Enter a valid phone number'); ok=false; }
      const pin=form.elements.namedItem('postcode') as HTMLInputElement;
      if(pin.value && !/^\d{6}$/.test(pin.value)){ setErr(pin,'Indian PIN is 6 digits'); ok=false; }
      if(!ok){ (form.querySelector('.invalid') as HTMLElement)?.scrollIntoView({behavior:'smooth',block:'center'}); }
      return ok;
    }

    let discount = 0; let coupon = '';

    async function initCheckout(){
      const Cart=(window as any).Cart; if(!Cart) return;
      const items=Cart.all();
      const empty=document.getElementById('co-empty')!;
      const form=document.getElementById('co-form') as HTMLFormElement;
      if(!items.length){ empty.classList.remove('hidden'); form.classList.add('hidden'); form.classList.remove('grid'); return; }
      empty.classList.add('hidden'); form.classList.remove('hidden'); form.classList.add('grid');

      let shipping=0;
      async function quoteShipping(){
        try{
          const country=(document.querySelector('[name=country]')||{}).value||'India';
          const zone=/india/i.test(country)?'domestic':'international';
          const r=await fetch('/api/shipping',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({items:items.map(it=>({slug:it.slug,qty:it.qty})),zone})});
          const d=await r.json(); shipping=d.ok?d.shipping:0;
        }catch{ shipping=0; }
      }
      function recalc(){
        const subtotal=Cart.subtotal();
        if((subtotal-discount)>=FREE_SHIPPING_OVER) shipping=0;
        const total=Math.max(0, subtotal-discount)+shipping;
        document.getElementById('co-items')!.innerHTML=items.map((it:any)=>`<li class="flex justify-between gap-3"><span>${it.name}${it.variant?` <span class="text-[var(--color-muted)]">(${it.variant})</span>`:''} × ${it.qty}</span><span>${inr(it.price*it.qty)}</span></li>`).join('');
        document.getElementById('co-subtotal')!.textContent=inr(subtotal);
        const dRow=document.getElementById('co-discount-row')!;
        if(discount>0){ dRow.hidden=false; document.getElementById('co-discount')!.textContent='– '+inr(discount); } else dRow.hidden=true;
        document.getElementById('co-shipping')!.textContent=shipping===0?'Free':inr(shipping);
        document.getElementById('co-total')!.textContent=inr(total);
        return { subtotal, shipping, total };
      }
      await quoteShipping(); let totals=recalc();
      document.getElementById('co-gst')?.addEventListener('change',(e)=>{ document.getElementById('co-gst-fields')!.hidden = !(e.target as HTMLInputElement).checked; });

      // #8 — auto-fill city/state from an Indian PIN code (India Post public API)
      const pin = form.querySelector('[name=postcode]') as HTMLInputElement | null;
      const cityI = form.querySelector('[name=city]') as HTMLInputElement | null;
      const stateS = form.querySelector('[name=state]') as HTMLSelectElement | null;
      const countryS = form.querySelector('[name=country]') as HTMLSelectElement | null;
      const pinHint = document.getElementById('pin-hint');
      async function lookupPin(){
        if(!pin || !countryS || countryS.value!=='India') return;
        const v=pin.value.trim();
        if(!/^\d{6}$/.test(v)){ if(pinHint) pinHint.textContent=''; return; }
        if(pinHint){ pinHint.textContent='Looking up…'; pinHint.style.color='var(--color-muted)'; }
        try{
          const r=await fetch('https://api.postalpincode.in/pincode/'+v);
          const d=await r.json();
          const po=d && d[0] && d[0].Status==='Success' && d[0].PostOffice && d[0].PostOffice[0];
          if(po){
            if(cityI && !cityI.value) cityI.value = po.District || po.Block || '';
            if(stateS && po.State){ for(const o of Array.from(stateS.options)){ if(o.value===po.State){ stateS.value=po.State; break; } } }
            if(pinHint){ pinHint.textContent='✓ '+(po.District||'')+', '+(po.State||''); pinHint.style.color='#1f6b2e'; }
          } else if(pinHint){ pinHint.textContent='PIN not found — enter city & state manually.'; pinHint.style.color='var(--color-muted)'; }
        }catch{ if(pinHint) pinHint.textContent=''; }
      }
      pin?.addEventListener('blur', lookupPin);
      pin?.addEventListener('input', ()=>{ if(pin.value.trim().length===6) lookupPin(); });
      // international: hide PIN hint & re-quote shipping
      countryS?.addEventListener('change', async()=>{ if(pinHint) pinHint.textContent=''; await quoteShipping(); totals=recalc(); });
      document.querySelector('[name=country]')?.addEventListener('change', async()=>{ await quoteShipping(); totals=recalc(); });

      document.getElementById('co-apply')?.addEventListener('click', async ()=>{
        const code=(document.getElementById('co-coupon') as HTMLInputElement).value.trim();
        const msg=document.getElementById('co-coupon-msg') as HTMLElement;
        if(!code){ return; }
        try{
          const r=await fetch('/api/discounts?coupon='+encodeURIComponent(code));
          const d=await r.json();
          if(d.ok && d.coupon){
            coupon=code;
            const sub=Cart.subtotal();
            discount = d.coupon.kind==='percent' ? Math.round(sub*d.coupon.value/100) : (d.coupon.kind==='fixed'? d.coupon.value*100 : 0);
            msg.hidden=false; msg.style.color='#1f6b2e'; msg.textContent=`Coupon “${code}” applied.`;
          } else { discount=0; coupon=''; msg.hidden=false; msg.style.color='#b00020'; msg.textContent='Invalid or expired coupon.'; }
        }catch{ msg.hidden=false; msg.style.color='#b00020'; msg.textContent='Could not check coupon.'; }
        totals=recalc();
      });

      form.onsubmit=async(e)=>{
        e.preventDefault();
        const err=document.getElementById('co-error') as HTMLElement; const payBtn=document.getElementById('co-pay') as HTMLButtonElement; const payLabel=document.getElementById('co-pay-label')!;
        err.hidden=true;
        if(!validate(form)) return;
        payBtn.disabled=true; const orig=payLabel.textContent; payLabel.textContent='Working…';
        const fd=new FormData(form); const customer=Object.fromEntries(fd.entries());
        totals=recalc();
        const gstWanted=(document.getElementById('co-gst') as HTMLInputElement)?.checked;
        const gst = gstWanted ? { gstin:(document.getElementById('co-gstin') as HTMLInputElement).value.trim().toUpperCase(), business:(document.getElementById('co-gst-name') as HTMLInputElement).value.trim() } : null;
        const order={ items:items.map((it:any)=>({slug:it.slug,name:it.name,qty:it.qty,variant:it.variant,price:it.price})), customer, coupon, gst, created:new Date().toISOString() };
        try{
          const res=await fetch('/api/checkout',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(order)});
          if(!res.ok) throw new Error(((await res.json().catch(()=>({}))) as any).error||'Could not start payment');
          const data=await res.json();
          const ok=await loadRazorpay();
          if(!ok) throw new Error('Could not reach the payment gateway. Please try again.');
          const rzp=new (window as any).Razorpay({
            key:data.key_id, order_id:data.order_id, amount:data.amount, currency:'INR',
            name:'aPaulogy', description:'Watercolours of a city that was',
            prefill:{ name:(customer as any).name, email:(customer as any).email, contact:(customer as any).phone },
            theme:{ color:'#000000' },
            handler:function(resp:any){
              try{ localStorage.setItem('apaulogy_last_order', JSON.stringify({...order,subtotal:totals.subtotal,shipping:totals.shipping,total:totals.total,reference:resp.razorpay_payment_id||data.order_id})); }catch{}
              Cart.clear();
              window.location.href='/order-confirmed/?ref='+encodeURIComponent(resp.razorpay_payment_id||data.order_id||'');
            },
            modal:{ ondismiss:function(){ payBtn.disabled=false; payLabel.textContent=orig; } },
          });
          rzp.open();
        }catch(ex:any){ err.textContent=ex.message||'Something went wrong. Please try again.'; err.hidden=false; payBtn.disabled=false; payLabel.textContent=orig; }
      };
    }
    initCheckout();
    document.addEventListener('cart:ready', initCheckout);
    document.addEventListener('cart:changed', initCheckout);
    document.addEventListener('astro:after-swap', initCheckout);
  </script>
</BaseLayout>
