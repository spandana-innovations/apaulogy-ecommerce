---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { getProducts, getTopCategories } from '../../lib/catalog';
import { breadcrumbSchema } from '../../lib/seo';

const products = getProducts();
const cats = getTopCategories();
const jsonld = [breadcrumbSchema([{ name: 'Home', url: '/' }, { name: 'Store', url: '/store/' }], Astro.site)];
---

<BaseLayout
  title="Store"
  description="Browse every signed watercolour print and piece of merchandise in the aPaulogy collection."
  jsonld={jsonld}
>
  <div class="container-page py-12">
    <nav class="text-xs text-[var(--color-muted)] mb-4" style="font-family:var(--font-sans)" aria-label="Breadcrumb">
      <a href="/" class="hover:text-[var(--color-terracotta)]">Home</a> <span aria-hidden="true">/</span> Store
    </nav>
    <header class="mb-10">
      <p class="eyebrow">The Store</p>
      <h1 class="text-5xl mt-2">All prints & pieces</h1>
      <p class="mt-3 text-[var(--color-ink-soft)] max-w-xl">{products.length} works and objects, each carrying a little of the city that was.</p>
    </header>

    <!-- Category chips -->
    <div class="flex flex-wrap gap-2 mb-10" style="font-family:var(--font-sans)">
      <a href="/store/" class="px-4 py-1.5 text-xs uppercase tracking-wide rounded-full border border-[var(--color-ink)] bg-[var(--color-ink)] text-[var(--color-paper)]">All</a>
      {cats.map((c) => (
        <a href={`/category/${c.slug}/`} class="px-4 py-1.5 text-xs uppercase tracking-wide rounded-full border border-[var(--color-line)] hover:border-[var(--color-ink)] transition-colors">{c.name}</a>
      ))}
    </div>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8">
      {products.map((p) => <ProductCard product={p} />)}
    </div>
  </div>
</BaseLayout>
