---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { getCategories, getCategory, getProductsByCategory, getChildCategories, hasMixedKinds } from '../../lib/catalog';
import { breadcrumbSchema, collectionSchema } from '../../lib/seo';

export function getStaticPaths() {
  return getCategories().map((c) => ({ params: { slug: c.slug } }));
}

const { slug } = Astro.params;
const category = getCategory(slug!);
if (!category) return Astro.redirect('/404');

const products = getProductsByCategory(slug!);
const children = getChildCategories(slug!);
const mixedKinds = hasMixedKinds(products);
const parent = category.parent_slug ? getCategory(category.parent_slug) : null;

const crumbs = [{ name: 'Home', url: '/' }, { name: 'Store', url: '/store/' }];
if (parent) crumbs.push({ name: parent.name, url: `/category/${parent.slug}/` });
crumbs.push({ name: category.name, url: `/category/${category.slug}/` });

const catImage = products[0]?.images?.[0]?.url;
const jsonld = [breadcrumbSchema(crumbs, Astro.site), collectionSchema(category.name, category.slug, products, Astro.site)];
---

<BaseLayout
  title={category.name}
  description={category.description || `Shop the ${category.name} collection from aPaulogy — watercolour prints and merchandise by Paul Fernandes of old Bangalore, Mumbai and Goa.`}
  image={catImage || '/og-default.png'}
  imageAlt={`${category.name} — aPaulogy`}
  jsonld={jsonld}
>
  <div class="container-page py-12">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/" class="link-hover">Home</a> <span aria-hidden="true">/</span>
      <a href="/store/" class="link-hover">Store</a> <span aria-hidden="true">/</span>
      {parent && (<><a href={`/category/${parent.slug}/`} class="link-hover">{parent.name}</a> <span aria-hidden="true">/</span> </>)}
      <span class="text-[var(--color-ink-soft)]">{category.name}</span>
    </nav>

    <header class="mb-10 max-w-2xl mx-auto text-center">
      <p class="eyebrow">Collection</p>
      <h1 class="text-5xl sm:text-6xl mt-3">{category.name}</h1>
      {category.description && <p class="mt-4 text-[var(--color-ink-soft)] text-lg">{category.description}</p>}
      <p class="series-tag mt-4">
        <span class="series-rule"></span>
        <span class="series-text">A Series of {products.length} {products.length === 1 ? 'Drawing' : 'Drawings'}</span>
        <span class="series-rule"></span>
      </p>
    </header>

    {children.length > 0 && (
      <div class="flex flex-wrap gap-2 mb-12" style="font-family:var(--font-sans)">
        {children.map((c) => (
          <a href={`/category/${c.slug}/`} class="px-4 py-1.5 text-[0.72rem] uppercase tracking-[0.12em] border border-[var(--color-line-strong)] hover:bg-black hover:text-white transition-colors">{c.name}</a>
        ))}
      </div>
    )}

    {products.length > 0 ? (
      <div class="flex justify-end mb-4"><div class="cols-control" role="group" aria-label="Products per row">
        <span class="text-[0.62rem] uppercase tracking-[0.12em] text-[var(--color-muted)] mr-2" style="font-family:var(--font-sans)">Per row</span>
        <button data-cols="2" aria-pressed="false">2</button><button data-cols="3" aria-pressed="true">3</button><button data-cols="4" aria-pressed="false">4</button>
      </div></div>
      <script is:inline>(function(){function init(){var g=document.querySelector('.product-grid');if(!g)return;var saved=localStorage.getItem('apg_cols')||'3';function set(n){g.style.setProperty('--cols',n);document.querySelectorAll('.cols-control button').forEach(function(b){b.setAttribute('aria-pressed',String(b.dataset.cols===n));});localStorage.setItem('apg_cols',n);}document.querySelectorAll('.cols-control button').forEach(function(b){b.addEventListener('click',function(){set(b.dataset.cols);});});set(saved);}if(document.readyState!=='loading')init();else document.addEventListener('DOMContentLoaded',init);document.addEventListener('astro:page-load',init);})();</script>

      <div class="product-grid grid gap-6 lg:gap-8">
        {products.map((p) => <ProductCard product={p} showKind={mixedKinds} />)}
      </div>
    ) : (
      <p class="text-[var(--color-ink-soft)]">New pieces are being added to this collection. <a href="/store/" class="link-underline">Browse the full store</a>.</p>
    )}
  </div>
</BaseLayout>
