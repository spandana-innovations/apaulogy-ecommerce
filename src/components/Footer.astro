---
import { SITE_TAGLINE } from '../lib/seo';
const year = new Date().getFullYear();

const cols = [
  {
    title: 'Shop',
    links: [
      { label: 'All Products', href: '/store/' },
      { label: 'Bangalore in the 70s', href: '/category/bangalore-70s/' },
      { label: 'Vintage Mumbai', href: '/category/vintage-mumbai/' },
      { label: 'Goa', href: '/category/goa/' },
      { label: 'Merchandise', href: '/category/merchandise/' },
    ],
  },
  {
    title: 'Gallery',
    links: [
      { label: 'About Us', href: '/about-us/' },
      { label: 'FAQ', href: '/faq/' },
      { label: 'Contact', href: '/contact/' },
    ],
  },
  {
    title: 'Help',
    links: [
      { label: 'Shipping & Returns', href: '/faq/#shipping' },
      { label: 'Terms & Conditions', href: '/terms-conditions/' },
      { label: 'Privacy Policy', href: '/privacy-policy/' },
    ],
  },
];
---

<footer class="mt-24 bg-[var(--color-heritage)] text-[#f2e9d8]">
  <div class="container-page py-14">
    <div class="grid gap-10 md:grid-cols-[1.4fr_1fr_1fr_1fr]">
      <div>
        <p class="font-display text-4xl leading-none">aPaulogy</p>
        <p class="mt-3 text-sm text-[#f2e9d8]/80 max-w-xs">{SITE_TAGLINE}. Signed watercolour prints & merchandise by Paul Fernandes, from Bengaluru.</p>
        <form class="mt-5 flex max-w-sm" data-newsletter>
          <input
            type="email"
            name="email"
            required
            placeholder="Your email"
            aria-label="Email for newsletter"
            class="flex-1 bg-[#f2e9d8]/10 border border-[#f2e9d8]/25 px-3 py-2 text-sm placeholder:text-[#f2e9d8]/50 focus:outline-none focus:border-[var(--color-mustard)]"
          />
          <button class="btn btn-primary !rounded-none !px-4 !py-2" type="submit">Join</button>
        </form>
        <p data-newsletter-msg class="mt-2 text-xs text-[var(--color-mustard)]" hidden></p>
      </div>

      {cols.map((col) => (
        <nav aria-label={col.title}>
          <h2 class="text-[0.72rem] font-semibold tracking-[0.2em] uppercase text-[var(--color-mustard)]" style="font-family:var(--font-sans)">{col.title}</h2>
          <ul class="mt-4 space-y-2.5 text-sm text-[#f2e9d8]/85">
            {col.links.map((l) => (
              <li><a href={l.href} class="hover:text-white transition-colors">{l.label}</a></li>
            ))}
          </ul>
        </nav>
      ))}
    </div>

    <div class="mt-12 pt-6 border-t border-[#f2e9d8]/15 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-[#f2e9d8]/70" style="font-family:var(--font-sans)">
      <p>© {year} aPaulogy. All artwork © Paul Fernandes.</p>
      <p class="flex items-center gap-2">
        <span>Secure payments by Razorpay</span>
        <span aria-hidden="true">·</span>
        <span>Made in Bengaluru</span>
      </p>
    </div>
  </div>
</footer>

<script>
  function initNewsletter() {
    document.querySelectorAll<HTMLFormElement>('[data-newsletter]').forEach((form) => {
      if (form.dataset.bound) return;
      form.dataset.bound = '1';
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const email = (form.querySelector('input[name=email]') as HTMLInputElement).value;
        const msg = form.parentElement?.querySelector('[data-newsletter-msg]') as HTMLElement | null;
        try {
          await fetch('/api/subscribe', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email }),
          });
          if (msg) { msg.textContent = 'Thank you — you’re on the list.'; msg.hidden = false; }
          form.reset();
        } catch {
          if (msg) { msg.textContent = 'Something went wrong. Please try again.'; msg.hidden = false; }
        }
      });
    });
  }
  initNewsletter();
  document.addEventListener('astro:after-swap', initNewsletter);
</script>
