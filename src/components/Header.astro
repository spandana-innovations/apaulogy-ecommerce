---
import { getMenu } from '../lib/catalog';
import { SITE_NAME } from '../lib/seo';
const menu = getMenu();
// Primary bar = everything except the trailing account group (already stripped in data)
---

<header class="sticky top-0 z-40 bg-white/95 backdrop-blur-sm border-b border-[var(--color-line-strong)]">
  <div class="container-page flex items-center justify-between h-[var(--header-h)] gap-4">
    <!-- Mobile menu toggle -->
    <button id="menu-toggle" class="lg:hidden -ml-1 p-2" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-nav">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <path d="M3 6h18M3 12h18M3 18h18" stroke-linecap="round" />
      </svg>
    </button>

    <a href="/" class="shrink-0" aria-label={`${SITE_NAME} home`}>
      <img src="/brand/logo-black.png" alt="aPaulogy — Curious Illustration" class="h-10 md:h-11 w-auto" width="360" height="139" />
    </a>

    <!-- Desktop nav -->
    <nav class="hidden lg:flex items-stretch gap-7 h-full" style="font-family:var(--font-sans)" aria-label="Primary">
      {menu.map((item) => (
        <div class="group relative flex items-center">
          <a
            href={item.href || '#'}
            class="inline-flex items-center gap-1 h-full text-[0.72rem] font-semibold uppercase tracking-[0.13em] text-[var(--color-ink)] hover:text-[var(--color-muted)] transition-colors"
            aria-haspopup={item.children.length ? 'true' : undefined}
          >
            {item.label}
            {item.children.length > 0 && (
              <svg width="9" height="9" viewBox="0 0 10 10" class="mt-0.5 opacity-60" aria-hidden="true"><path d="M1 3l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
            )}
          </a>

          {item.children.length > 0 && (
            <div class="invisible opacity-0 group-hover:visible group-hover:opacity-100 focus-within:visible focus-within:opacity-100 transition-opacity duration-150 absolute top-full left-0 pt-0">
              <div class="mt-[-1px] min-w-[15rem] bg-white border border-[var(--color-line-strong)] shadow-[var(--shadow-frame)] p-5">
                <div class="flex gap-8">
                  {item.children.map((child) => (
                    child.children.length > 0 ? (
                      <div class="min-w-[11rem]">
                        <p class="text-[0.62rem] font-semibold uppercase tracking-[0.18em] text-[var(--color-muted)] mb-2.5 pb-2 border-b border-[var(--color-line)]">
                          {child.href ? <a href={child.href} class="link-hover">{child.label}</a> : child.label}
                        </p>
                        <ul class="space-y-1.5">
                          {child.children.map((leaf) => (
                            <li><a href={leaf.href || '#'} class="block text-[0.82rem] tracking-wide text-[var(--color-ink-soft)] hover:text-[var(--color-ink)] hover:underline underline-offset-4">{leaf.label}</a></li>
                          ))}
                        </ul>
                      </div>
                    ) : (
                      <div class="min-w-[10rem] self-start">
                        <a href={child.href || '#'} class="block text-[0.82rem] tracking-wide text-[var(--color-ink-soft)] hover:text-[var(--color-ink)] hover:underline underline-offset-4 py-0.5">{child.label}</a>
                      </div>
                    )
                  ))}
                </div>
              </div>
            </div>
          )}
        </div>
      ))}
    </nav>

    <a href="/cart/" class="relative p-2 shrink-0" aria-label="Cart">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z" stroke-linejoin="round"/>
        <path d="M3 6h18M16 10a4 4 0 0 1-8 0" stroke-linecap="round"/>
      </svg>
      <span data-cart-count hidden class="absolute -top-0.5 -right-0.5 min-w-[1.1rem] h-[1.1rem] px-1 rounded-full bg-black text-white text-[0.65rem] font-bold grid place-items-center" style="font-family:var(--font-sans)">0</span>
    </a>
  </div>

  <!-- Mobile nav (accordion) -->
  <nav id="mobile-nav" class="lg:hidden hidden border-t border-[var(--color-line)] bg-white max-h-[80vh] overflow-y-auto" aria-label="Mobile" style="font-family:var(--font-sans)">
    <ul class="container-page py-2">
      {menu.map((item) => (
        <li class="border-b border-[var(--color-line)]">
          <div class="flex items-center justify-between">
            <a href={item.href || '#'} class="block py-3 text-[0.8rem] uppercase tracking-[0.12em] font-semibold flex-1">{item.label}</a>
            {item.children.length > 0 && (
              <button class="m-submenu-toggle p-3" aria-label={`Toggle ${item.label}`} aria-expanded="false">
                <svg width="14" height="14" viewBox="0 0 10 10" aria-hidden="true"><path d="M1 3l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
            )}
          </div>
          {item.children.length > 0 && (
            <ul class="m-submenu hidden pb-3 pl-3">
              {item.children.map((child) => (
                <li>
                  {child.href
                    ? <a href={child.href} class="block py-2 text-[0.85rem] text-[var(--color-ink-soft)]">{child.label}</a>
                    : <p class="pt-3 pb-1 text-[0.62rem] uppercase tracking-[0.16em] text-[var(--color-muted)]">{child.label}</p>}
                  {child.children.length > 0 && (
                    <ul class="pl-3">
                      {child.children.map((leaf) => (
                        <li><a href={leaf.href || '#'} class="block py-1.5 text-[0.85rem] text-[var(--color-ink-soft)]">{leaf.label}</a></li>
                      ))}
                    </ul>
                  )}
                </li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  function initMenu() {
    const btn = document.getElementById('menu-toggle');
    const nav = document.getElementById('mobile-nav');
    if (btn && nav && !btn.dataset.bound) {
      btn.dataset.bound = '1';
      btn.addEventListener('click', () => {
        const open = nav.classList.toggle('hidden') === false;
        btn.setAttribute('aria-expanded', String(open));
      });
    }
    document.querySelectorAll('.m-submenu-toggle').forEach((b) => {
      if ((b as HTMLElement).dataset.bound) return;
      (b as HTMLElement).dataset.bound = '1';
      b.addEventListener('click', () => {
        const sub = (b.closest('li') as HTMLElement)?.querySelector('.m-submenu');
        if (sub) {
          const open = sub.classList.toggle('hidden') === false;
          b.setAttribute('aria-expanded', String(open));
          (b as HTMLElement).style.transform = open ? 'rotate(180deg)' : '';
        }
      });
    });
  }
  initMenu();
  document.addEventListener('astro:after-swap', initMenu);
</script>
