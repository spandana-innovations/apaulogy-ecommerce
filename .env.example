# Copy to `.env` for local dev, and set the same values as Pages secrets in
# the Cloudflare dashboard (Settings -> Environment variables) for production.
# NEVER commit real keys.

# Public site URL (used for canonical URLs, sitemap, Open Graph)
SITE_URL="https://apaulogy.com"

# --- Razorpay ---
# Key ID is public (used in the browser checkout). Key Secret is server-only.
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
# Webhook secret configured in the Razorpay dashboard (Settings -> Webhooks)
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret"

# Media (R2) public base URL — the custom domain mapped to the R2 bucket
MEDIA_BASE_URL="https://cdn.apaulogy.com"

# Store currency
CURRENCY="INR"
