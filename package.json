{
  "name": "apaulogy-ecommerce",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "aPaulogy — fast, SEO-optimised art & merchandise store on Cloudflare Pages, D1 and R2.",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "wrangler pages dev ./dist",
    "astro": "astro",
    "typecheck": "astro check",
    "import": "node scripts/import-woocommerce.mjs",
    "db:local": "wrangler d1 execute apaulogy --local --file=./db/schema.sql",
    "db:remote": "wrangler d1 execute apaulogy --remote --file=./db/schema.sql",
    "db:seed:local": "wrangler d1 execute apaulogy --local --file=./db/seed.sql",
    "db:seed:remote": "wrangler d1 execute apaulogy --remote --file=./db/seed.sql"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.0",
    "@astrojs/sitemap": "^3.4.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "astro": "^5.13.0",
    "sharp": "^0.34.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "fast-xml-parser": "^5.2.0",
    "tailwindcss": "^4.1.0",
    "wrangler": "^4.28.0"
  }
}
